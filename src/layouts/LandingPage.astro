---
// Template for service, charger, battery, audience and one-off landing pages (Markdown in src/content/).
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Faqs from '../components/Faqs.astro';
import CostFactors from '../components/CostFactors.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CtaBand from '../components/CtaBand.astro';
import SectionHead from '../components/SectionHead.astro';
import DcInside from '../components/widgets/DcInside.astro';
import WhiteLabel from '../components/widgets/WhiteLabel.astro';
import site from '../data/site.json';
import { linkInfo } from '../data/nav';
import { serviceNode, faqNode, articleNode } from '../lib/schema';
import { inlineMd, plainText, waLink, formatDate } from '../lib/text';

type Entry = CollectionEntry<'services'> | CollectionEntry<'chargers'> | CollectionEntry<'batteries'> | CollectionEntry<'audiences'> | CollectionEntry<'pages'>;
interface Props { entry: Entry; crumbs: { label: string; href?: string }[]; headerCta?: { label: string; href: string } }
const { entry, crumbs, headerCta } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const path = Astro.url.pathname;

const ctaLabel = { survey: 'Book a site survey', demo: 'Book a demo', station: 'Plan your station', b2b: 'Partner with us', brand: 'Become a brand partner', technician: 'Apply now', ask: 'Ask your question', quote: 'Get a quote' }[d.form];
// Shorter labels for the header button, so it fits beside the logo on 360 px phones.
const headerLabel = { survey: 'Book a survey', brand: 'Partner with us', ask: 'Ask a question' }[d.form as string] ?? ctaLabel;
const schema: object[] = [];
if (d.serviceType) schema.push(serviceNode(path, d.h1, plainText(d.intro), d.serviceType));
if (d.faqs.length) schema.push(faqNode(path, d.faqs));
const ogImage = d.photo ?? (d.image ? `/images/og/${d.image}.jpg` : undefined);
if (d.guide) schema.push(articleNode(path, { title: d.h1, description: d.description, date: d.updated, updated: d.updated, image: d.photo ?? (d.image ? `/images/${d.image}.webp` : undefined) }));
const toc = headings.filter((h) => h.depth === 2);
const tool = d.related.find((r) => r.startsWith('/tools/'));
const toolInfo = tool ? linkInfo(tool) : undefined;
const wa = `Hello Proline, I am looking at ${d.label} on your website. Can you help?`;
---
<Base title={d.title} description={d.description} crumbs={crumbs} schema={schema} image={ogImage} imageAlt={d.photo ? (d.photoAlt ?? d.h1) : d.h1} waText={wa} headerCta={headerCta ?? { label: headerLabel, href: '#quote' }} ogType={d.guide ? 'article' : 'website'}>
  <section class="phero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class:list={['phero-grid', { 'no-media': !d.image && !d.photo }]}>
        <div>
          {d.eyebrow && <p class="eyebrow">{d.eyebrow}</p>}
          <h1>{d.h1}</h1>
          <p class="lead" set:html={inlineMd(d.intro)} />
          <div class="btn-row">
            <a class="btn btn-primary btn-lg" href="#quote">{ctaLabel}</a>
            <a class="btn btn-outline btn-lg" href={waLink(site.whatsapp, wa)} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />WhatsApp us</a>
          </div>
          {d.highlights.length > 0 && (
            <ul class="checks">{d.highlights.map((h) => <li><Icon name="check" size={18} stroke={2.5} />{h}</li>)}</ul>
          )}
          {d.guide && <p class="updated" style="margin-top:18px">By Vineet Saini, Proline Electrical Works · Updated {formatDate(d.updated)}</p>}
        </div>
        {(d.photo || d.image) && <div class="phero-media">{d.photo ? <Photo src={d.photo} alt={d.photoAlt ?? d.h1} eager /> : <Photo name={d.image} eager sizes="(max-width: 900px) 100vw, 480px" />}</div>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap layout-side">
      <div>
      <article class="prose" id="page-body">
        <Content />
        {d.guide && (
          <div class="author" style="margin-top:40px">
            <span class="avatar" aria-hidden="true">VS</span>
            <div><strong>Vineet Saini</strong><span>Proline Electrical Works, Delhi. Installing EV chargers across India for {site.stats[3].value}, with {site.stats[0].value} chargers installed.</span></div>
          </div>
        )}
      </article>
      <button class="btn btn-outline fold-more" type="button" hidden>Read the full page<Icon name="chevronDown" size={18} /></button>
      </div>
      <aside class="side-sticky" aria-label="Contact and contents">
        <div class="side-card side-cta">
          <h3>Talk to an engineer</h3>
          <p>Send photos of your meter, DB and parking spot and we tell you what the job needs.</p>
          <a class="btn btn-primary" href="#quote">{ctaLabel}</a>
          <p class="small" style="margin-top:10px"><a href={waLink(site.whatsapp, wa)} rel="noopener" target="_blank">WhatsApp any time</a> · <a href={`tel:${site.phoneE164}`}>Call 10 am–7 pm</a></p>
        </div>
        {toc.length > 2 && (
          <nav class="side-card side-toc" aria-label="On this page">
            <h3>On this page</h3>
            <ul style="list-style:none;display:grid;gap:8px;font-size:15px">
              {toc.map((h) => <li><a href={`#${h.slug}`} style="text-decoration:none">{h.text}</a></li>)}
            </ul>
          </nav>
        )}
        {toolInfo && (
          <a class="side-card" href={toolInfo.href} style="display:block;text-decoration:none;border:1px solid var(--line);background:#fff">
            <span class="pill pill-green">Free tool</span>
            <h3 style="margin-top:10px">{toolInfo.label}</h3>
            <p>{toolInfo.note}</p>
            <span class="link-arrow" style="margin-top:8px">Open<Icon name="arrowRight" size={16} /></span>
          </a>
        )}
      </aside>
    </div>
  </section>

  {d.widget && (
    <section class="section section-soft" id="widget">
      <div class="wrap">{d.widget === 'dc-inside' ? <DcInside /> : <WhiteLabel />}</div>
    </section>
  )}

  {(d.costFactors.length > 0 || d.showProcess) && (
    <section class="section section-soft fold-zone" aria-label="Cost and steps">
      <div class="wrap folds">
        {d.costFactors.length > 0 && (
          <details class="fold-sec">
            <summary><span class="card-icon"><Icon name="tag" size={20} /></span><span class="fs-text"><strong>What decides the cost</strong><span>{d.costFactors.length} things that decide your quote</span></span><Icon name="chevronDown" size={20} class="chev" /></summary>
            <div class="fold-body"><CostFactors items={d.costFactors} bare /></div>
          </details>
        )}
        {d.showProcess && (
          <details class="fold-sec">
            <summary><span class="card-icon"><Icon name="list" size={20} /></span><span class="fs-text"><strong>{d.steps ? 'How the job runs' : 'Six steps from survey to handover'}</strong><span>{(d.steps ?? []).length || 6} steps, from first message to handover</span></span><Icon name="chevronDown" size={20} class="chev" /></summary>
            <div class="fold-body"><ProcessSteps steps={d.steps} /></div>
          </details>
        )}
      </div>
    </section>
  )}

  {d.faqs.length > 0 && (
    <section class="section section-soft" aria-labelledby="faq-title">
      <div class="wrap-narrow">
        <SectionHead eyebrow="FAQ" title={`${d.label}: questions and answers`} center id="faq-title" />
        <Faqs items={d.faqs} />
      </div>
    </section>
  )}

  <RelatedLinks links={d.related} />
  <CtaBand variant={d.form} need={d.need} waText={wa} />
  <script is:inline>
    // Long page text starts folded (the full text stays in the page for Google); "Read the full page" opens it.
    // A link to a heading inside the text (from this page or another) opens it too.
    (function () {
      var body = document.getElementById('page-body');
      var more = body && body.nextElementSibling;
      function target(hash) { var el = hash && hash.length > 1 && document.getElementById(decodeURIComponent(hash.slice(1))); return el && body.contains(el) ? el : null; }
      if (!body || !more || body.scrollHeight < 1100 || target(location.hash)) return;
      body.classList.add('folded');
      more.hidden = false;
      function open() { body.classList.remove('folded'); more.hidden = true; }
      more.addEventListener('click', open);
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href*="#"]');
        if (a && a.pathname === location.pathname && target(a.hash)) open();
      });
      window.addEventListener('hashchange', function () {
        var el = target(location.hash);
        if (el && body.classList.contains('folded')) { open(); el.scrollIntoView(); }
      });
    })();
  </script>
</Base>
