---
// Responsive photo.
// - Stock photos: `name` = key in src/data/images.json (1600w + 800w WebP in public/images, alt text there).
// - Owner uploads from the admin: `src` = /images/uploads/… (Sveltia CMS converts uploads to WebP, max 1600 px).
import images from '../data/images.json';
import sharp from 'sharp';
import { join } from 'node:path';
interface Props { name?: string; src?: string; alt?: string; sizes?: string; eager?: boolean; class?: string; style?: string }
const { name, src: upload, alt, sizes = '(max-width: 900px) 100vw, 50vw', eager = false, class: cls, style } = Astro.props;

let src: string, srcset: string | undefined, w: number, h: number, altText: string;
if (upload) {
  src = upload;
  srcset = undefined;
  try {
    const m = await sharp(join(process.cwd(), 'public', upload.replace(/^\//, ''))).metadata();
    w = m.width ?? 1600; h = m.height ?? 1200;
  } catch { w = 1600; h = 1200; }
  altText = alt ?? '';
} else {
  const meta = (images as Record<string, { alt: string; sizes: Record<string, [number, number]> }>)[name ?? ''];
  if (!meta) throw new Error(`Photo "${name}" is not in src/data/images.json`);
  [w, h] = meta.sizes['1600'];
  const [w8] = meta.sizes['800'];
  src = `/images/${name}.webp`;
  srcset = `/images/${name}-800.webp ${w8}w, /images/${name}.webp ${w}w`;
  altText = alt ?? meta.alt;
}
---
<img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} width={w} height={h} alt={altText}
  loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : undefined}
  class={cls} style={style} />
