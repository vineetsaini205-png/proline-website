---
// One enquiry form, several shapes. Sends to the Google Apps Script URL in src/data/site.json
// (formEndpoint). Strategy plan (13 Nov 2026), section 10: four main enquiry types with short required fields
//   quote   = personal charger / installation: phone, city or PIN, vehicle, help needed (name optional)
//   station = commercial site: phone, city, site type, site status (name optional)
//   b2b     = brand partnership: name, company, email or phone, regions
//   demo    = CMS demo: name, email or phone, operation, charger count
// Extra fields are named x_* with a data-label; forms.ts sends them, with an enquiry reference, in the Details column.
import site from '../data/site.json';
import Icon from './Icon.astro';

export type FormVariant = 'quote' | 'survey' | 'station' | 'demo' | 'b2b' | 'brand' | 'technician' | 'ask';
interface Props {
  variant?: FormVariant;
  title?: string;
  intro?: string;
  need?: string;
  submitLabel?: string;
  id?: string;
  vehicleRequired?: boolean; // personal charger pages ask for the vehicle; other quote pages make it optional
}
const { variant = 'quote', title, intro, need, submitLabel, id = 'enquiry-form', vehicleRequired = true } = Astro.props;

const needs = [
  'EV charger installation',
  'Home charger installation',
  'DC fast charger or charging station',
  'Help choosing a charger (any brand)',
  'Site survey',
  'EV charger AMC (maintenance)',
  'Earthing, cabling or DB box',
  'Civil work or canopy',
  'Solar installation',
  'Batteries',
  'Proline CMS',
  'Something else',
];
const siteTypes = ['Home or villa', 'Housing society or apartment', 'Office, hotel, mall or hospital', 'Fuel station, highway or public parking', 'Fleet depot or e-rickshaw hub', 'Factory or warehouse', 'Government or PSU site', 'Other'];
const states = ['Delhi', 'Haryana', 'Uttar Pradesh', 'Uttarakhand', 'Himachal Pradesh', 'Maharashtra', 'Madhya Pradesh', 'Chhattisgarh', 'Telangana', 'Tamil Nadu', 'Other state'];

const defaults: Record<FormVariant, { title: string; submit: string; intro?: string }> = {
  quote: { title: 'Help me choose a charger', submit: 'Send enquiry' },
  survey: { title: 'Book a site survey', submit: 'Request a survey', intro: 'Site surveys are paid. The fee is adjusted against your order if you go ahead with Proline.' },
  station: { title: 'Discuss my site', submit: 'Send site details' },
  demo: { title: 'Request a Proline CMS demo', submit: 'Request a demo slot' },
  b2b: { title: 'Discuss an installation partnership', submit: 'Send partnership enquiry' },
  brand: { title: 'Discuss an installation partnership', submit: 'Send partnership enquiry' },
  technician: { title: 'Join our technician network', submit: 'Send my details' },
  ask: { title: 'Ask an expert', submit: 'Send my question' },
};
const d = defaults[variant];
const heading = title ?? d.title;
const lead = intro ?? d.intro;
const defaultNeed = need ?? (variant === 'survey' ? 'Site survey' : variant === 'demo' ? 'Proline CMS' : undefined);
const f = (n: string) => `${id}-${n}`;
const v = variant === 'brand' ? 'b2b' : variant;
const nameOptional = v === 'quote' || v === 'station';
const emailOrPhone = v === 'b2b' || v === 'demo';
---
<form class="form-card" id={id} data-enquiry data-variant={variant} data-endpoint={site.formEndpoint} data-wa={site.whatsapp} novalidate>
  <div class="form-body">
    <h3>{heading}</h3>
    {lead && <p class="small muted" style="margin-top:6px">{lead}</p>}
    <input type="hidden" name="form" value={variant} />
    <input type="hidden" name="extra" value="" />
    <div class="hp" aria-hidden="true"><label>Leave this empty<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label></div>

    <div class="form-grid">
      <div class="field">
        <label for={f('phone')}>{emailOrPhone ? 'Phone or work email' : 'Phone or WhatsApp number'}</label>
        {emailOrPhone
          ? <input id={f('phone')} name="phone" type="text" inputmode="email" autocomplete="email" required maxlength="100" data-contact="phone-or-email" placeholder="Mobile number or email" />
          : <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="16" placeholder="10-digit mobile" />}
        <p class="err">{emailOrPhone ? 'Please enter a 10-digit mobile number or an email address.' : 'Please enter a 10-digit mobile number.'}</p>
      </div>
      <div class="field">
        <label for={f('name')}>Your name {nameOptional && <span class="opt">(optional)</span>}</label>
        <input id={f('name')} name="name" type="text" autocomplete="name" required={!nameOptional} maxlength="80" />
        <p class="err">Please enter your name.</p>
      </div>

      {v === 'b2b' && (
        <div class="field">
          <label for={f('company')}>Company</label>
          <input id={f('company')} name="company" type="text" autocomplete="organization" required maxlength="100" />
          <p class="err">Please enter the company name.</p>
        </div>
      )}
      {v === 'demo' && (
        <div class="field">
          <label for={f('company')}>Company <span class="opt">(optional)</span></label>
          <input id={f('company')} name="company" type="text" autocomplete="organization" maxlength="100" />
        </div>
      )}

      {!['b2b', 'demo'].includes(v) && (
        <div class="field">
          <label for={f('city')}>{v === 'quote' ? 'City or PIN code' : 'City'}</label>
          <input id={f('city')} name="city" type="text" autocomplete="address-level2" required maxlength="60" />
          <p class="err">Please enter your {v === 'quote' ? 'city or PIN code' : 'city'}.</p>
        </div>
      )}

      {v === 'quote' && (
        <div class="field">
          <label for={f('vehicle')}>Vehicle model {!vehicleRequired && <span class="opt">(optional)</span>}</label>
          <input id={f('vehicle')} name="x_vehicle" data-label="Vehicle" type="text" required={vehicleRequired} maxlength="80" placeholder="e.g. Tata Nexon.ev, Ather 450X, e-rickshaw" />
          <p class="err">Please tell us your vehicle.</p>
        </div>
      )}

      {v === 'b2b' && (
        <div class="field">
          <label for={f('regions')}>Regions you need covered</label>
          <input id={f('regions')} name="x_regions" data-label="Regions" type="text" required maxlength="160" placeholder="e.g. Delhi NCR and Maharashtra" />
          <p class="err">Please tell us the regions.</p>
        </div>
      )}

      {v === 'demo' && (
        <div class="field">
          <label for={f('operation')}>Your charging operation</label>
          <select id={f('operation')} name="x_operation" data-label="Operation" required>
            <option value="">Choose one</option>
            <option>We run charging stations now</option><option>We are planning stations</option>
          </select>
          <p class="err">Please choose one.</p>
        </div>
      )}

      {variant === 'technician' && (
        <div class="field">
          <label for={f('state')}>State</label>
          <select id={f('state')} name="state" required>
            <option value="">Choose a state</option>
            {states.map((s) => <option>{s}</option>)}
          </select>
          <p class="err">Please choose a state.</p>
        </div>
      )}

      {variant === 'quote' && (
        <div class="field">
          <label for={f('need')}>What do you need?</label>
          <select id={f('need')} name="need" required>
            <option value="">Choose one</option>
            {needs.map((n) => <option selected={n === defaultNeed}>{n}</option>)}
          </select>
          <p class="err">Please choose what you need.</p>
        </div>
      )}

      {['survey', 'station'].includes(variant) && (
        <div class="field">
          <label for={f('site')}>Type of site</label>
          <select id={f('site')} name="site_type" required>
            <option value="">Choose one</option>
            {siteTypes.map((s) => <option>{s}</option>)}
          </select>
          <p class="err">Please choose the type of site.</p>
        </div>
      )}

      {variant === 'station' && (
        <div class="field">
          <label for={f('status')}>Site status</label>
          <select id={f('status')} name="x_site_status" data-label="Site status" required>
            <option value="">Choose one</option>
            <option>Site is available</option><option>Looking for a site</option><option>Planning stage</option>
          </select>
          <p class="err">Please choose one.</p>
        </div>
      )}
      {variant === 'quote' && (
        <div class="field">
          <label for={f('existing')}>Charger you already have <span class="opt">(optional)</span></label>
          <input id={f('existing')} name="x_existing" data-label="Existing charger" type="text" maxlength="120" placeholder="e.g. came with the car, 7.2 kW wall box" />
        </div>
      )}

      {variant === 'demo' && (
        <div class="field">
          <label for={f('chargers')}>Number of chargers</label>
          <select id={f('chargers')} name="chargers" required>
            <option value="">Choose one</option>
            <option>1–10</option><option>11–50</option><option>51–200</option><option>More than 200</option><option>Not yet, planning</option>
          </select>
          <p class="err">Please choose one.</p>
        </div>
      )}

      {v === 'b2b' && (
        <>
          <div class="field">
            <label for={f('sites')}>Expected jobs a month <span class="opt">(optional)</span></label>
            <select id={f('sites')} name="sites_per_month">
              <option value="">Choose one</option>
              <option>1–5</option><option>6–20</option><option>21–50</option><option>More than 50</option><option>One project</option>
            </select>
            <p class="err">Please choose one.</p>
          </div>
          <div class="field full">
            <label for={f('states')}>Charger types <span class="opt">(optional)</span></label>
            <input id={f('states')} name="states_types" type="text" maxlength="160" placeholder="e.g. 7.4 kW AC wall boxes, 60 kW DC" />
          </div>
        </>
      )}

      {variant === 'technician' && (
        <>
          <div class="field">
            <label for={f('exp')}>Experience</label>
            <select id={f('exp')} name="experience" required>
              <option value="">Choose one</option>
              <option>Less than 1 year</option><option>1–3 years</option><option>3–5 years</option><option>More than 5 years</option>
            </select>
            <p class="err">Please choose one.</p>
          </div>
          <div class="field full">
            <label for={f('skills')}>Skills and licences <span class="opt">(optional)</span></label>
            <input id={f('skills')} name="skills" type="text" maxlength="200" placeholder="e.g. wiring licence, AC/DC charger installation, earthing, civil work, team size" />
          </div>
        </>
      )}

      {v === 'demo' && (
        <div class="field full">
          <label for={f('brands')}>Charger brands and models <span class="opt">(optional)</span></label>
          <input id={f('brands')} name="x_brands" data-label="Charger brands" type="text" maxlength="160" placeholder="e.g. 10 × 60 kW DC from two makers" />
        </div>
      )}
      {v !== 'quote' && <div class="field full">
        {variant === 'ask' ? (
          <>
            <label for={f('msg')}>Your question</label>
            <textarea id={f('msg')} name="message" required maxlength="1500" rows="5" placeholder="e.g. Can I install a 7.4 kW charger on a single-phase connection?"></textarea>
            <p class="err">Please type your question.</p>
          </>
        ) : (
          <>
            <label for={f('msg')}>{variant === 'station' ? 'Short requirement' : v === 'demo' ? 'Main software requirement' : 'Message'} <span class="opt">(optional)</span></label>
            <textarea id={f('msg')} name="message" maxlength="1500" rows="3" placeholder={variant === 'station' ? 'Location, parking spaces, chargers you have in mind…' : variant === 'demo' ? 'What you want to see in the demo…' : 'Charger, site, timeline, anything that helps…'}></textarea>
          </>
        )}
      </div>}

      {variant === 'ask' && (
        <div class="field full">
          <label style="display:flex;gap:10px;align-items:flex-start;font-weight:500"><input type="checkbox" name="publish_ok" value="yes" style="width:20px;min-height:20px;margin-top:2px;accent-color:#0B7D4A" />You may publish my question and the answer on this site, without my name or number.</label>
        </div>
      )}
    </div>

    <div class="form-foot">
      <button class="btn btn-primary btn-lg" type="submit">{submitLabel ?? d.submit}<Icon name="arrowRight" size={18} /></button>
      <p class="small">Proline will contact you about this enquiry only; we don’t add you to any mailing list. <a href="/privacy-policy/">Privacy policy</a></p>
    </div>
    <p class="small muted form-status" role="status" aria-live="polite" style="margin-top:10px"></p>
  </div>

  <div class="form-done" tabindex="-1">
    <div class="done-icon"><Icon name="check" size={26} stroke={2.5} /></div>
    <h3 data-done-title>Your message is ready in WhatsApp</h3>
    <p style="margin-top:8px" data-done-text>We reply on WhatsApp or by phone. Calls are answered 10 am–7 pm; WhatsApp any time.</p>
    <div class="btn-row" style="margin-top:18px">
      <a class="btn btn-primary" data-done-wa href={`https://wa.me/${site.whatsapp}`} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />Send on WhatsApp</a>
      <a class="btn btn-outline" href={`tel:${site.phoneE164}`}><Icon name="phone" size={20} />Call {site.phoneDisplay}</a>
      <button class="btn btn-sm" type="button" data-reset style="background:var(--soft);color:var(--ink)">Send another enquiry</button>
    </div>
  </div>
</form>
