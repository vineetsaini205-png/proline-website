---
// The owner's Charge-O logo (logo pack, Oct 2026; master files in src/assets/logo/).
// Colour version on light backgrounds; white version on navy (footer). Do not stretch or recolour it.
import colour from '../assets/logo/proline-horizontal.svg?url';
import white from '../assets/logo/proline-horizontal-white.svg?url';
interface Props { href?: string; class?: string; variant?: 'colour' | 'white'; lazy?: boolean }
const { href = '/', class: cls = '', variant = 'colour', lazy = false } = Astro.props;
---
<a href={href} class:list={['logo', cls]}>
  <img src={variant === 'white' ? white : colour} width="158" height="40" alt="Proline Electrical Works, home" loading={lazy ? 'lazy' : undefined} decoding="async" />
</a>
