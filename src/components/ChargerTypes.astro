</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cr]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.cr-card')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const btn = root.querySelector<HTMLButtonElement>('[data-cr-motion]');
    const mq = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = mq.matches;
    const sync = () => {
      root.classList.toggle('is-paused', paused || document.hidden);
      if (!btn) return;
      btn.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation');
      root.querySelector('[data-cr-motion-label]')!.textContent = paused ? 'Play motion' : 'Pause motion';
      root.querySelector('[data-cr-motion-icon]')!.innerHTML = paused ? '<path d="m5 2 9 6-9 6Z"/>' : '<path d="M4 3h3v10H4zm5 0h3v10H9z"/>';
    };
    btn?.addEventListener('click', () => { paused = !paused; sync(); });
    document.addEventListener('visibilitychange', sync);
    mq.addEventListener('change', (e) => { paused = e.matches; sync(); });
    filters.forEach((f) => f.addEventListener('click', () => {
      const type = f.dataset.filter;
      let n = 0;
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === f)));
      cards.forEach((c) => { c.hidden = type !== 'all' && c.dataset.type !== type; if (!c.hidden) n++; });
      root.querySelector('[data-cr-status]')!.textContent = `${n} charger types shown.`;
    }));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('is-visible', e.isIntersecting)), { threshold: 0.05 });
      cards.forEach((c) => io.observe(c));
    } else cards.forEach((c) => c.classList.add('is-visible'));
    sync();
  });
</script>
