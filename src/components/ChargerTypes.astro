  .cr-quote { align-self: flex-start; margin-top: 4px; font-size: 13.5px; font-weight: 700; color: var(--navy); text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .cr-compact .cr-quote { margin-top: auto; }
  .cr-quote:hover { color: var(--cr-green); text-decoration: underline; }
  .cr-foot { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); }
  .cr-foot p { font-size: 13px; line-height: 1.6; color: var(--muted); max-width: 680px; }
  .cr-tag { font-size: 11px; color: #6f7f74; letter-spacing: .1em; white-space: nowrap; text-transform: uppercase; }
  .cr-dot-live { display: inline-block; width: 6px; height: 6px; margin-right: 6px; border-radius: 50%; background: #15a16c; vertical-align: 1px; }
  .cr-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

  .cr-hw { transition: transform .3s ease; transform-origin: center bottom; }
  .cr-led { animation: cr-led 3.6s ease-in-out infinite; animation-play-state: var(--cr-motion, paused); }
  .cr-late { animation-delay: -1.2s; }
  .cr-later { animation-delay: -2.4s; }
  .cr-fill { transform-box: fill-box; transform-origin: left center; animation: cr-charge 5s ease-in-out infinite; animation-play-state: var(--cr-motion, paused); }
  .cr-dot { animation: cr-led 3.6s ease-in-out infinite; animation-play-state: var(--cr-motion, paused); }
  @keyframes cr-led { 0%, 100% { opacity: .38; } 50% { opacity: 1; } }
  @keyframes cr-charge { 0%, 12% { transform: scaleX(.2); opacity: .65; } 65%, 85% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(.2); opacity: .65; } }
  @media (prefers-reduced-motion: reduce) {
