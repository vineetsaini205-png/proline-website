---
import site from '../data/site.json';
import { mainNav, tools, resources, company } from '../data/nav';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { waLink } from '../lib/text';

interface Props { cta?: { label: string; href: string }; waText?: string }
const { waText } = Astro.props;
const path = Astro.url.pathname;
// Header: Call and WhatsApp stay visible outside the menu (strategy plan). `cta` is still accepted from pages but not shown here.

const menuNotes: Record<string, string> = {
  'Choose a charger': 'We compare brands around your vehicle and site.',
  'Commercial charging': 'Start with the site, the costs and expected usage.',
  Installation: 'Not sure what you need? Start with a site survey.',
  'For charger brands': 'Agreed checklists, site reports, commissioning.',
  'Proline CMS': 'No Proline commission on charging payments.',
  'Our work': 'We visit your site. No showroom or walk-in office.',
};
const isCurrent = (href?: string) => !!href && href !== '/' && path.startsWith(href);
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="offer">
  <div class="wrap">
    <p><span class="dot" aria-hidden="true"></span>{site.offerStrip}</p>
    <p class="offer-hours"><a href={`tel:${site.phoneE164}`}>Call {site.phoneDisplay}</a> ({site.callHours.replace(/^Calls\s*/i, '')}) · <a href={waLink(site.whatsapp, waText)} rel="noopener" target="_blank">{site.whatsappHours}</a></p>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label="Main menu">
      <ul>
        {mainNav.map((g, i) => g.items ? (
          <li class="has-menu">
            <button class="nav-link" type="button" aria-expanded="false" aria-controls={`menu-${i}`}>{g.label}<Icon name="chevronDown" size={16} class="chev" /></button>
            <div class="menu" id={`menu-${i}`} style={g.items.length > 6 ? 'min-width: 560px' : undefined}>
              <div class:list={[{ 'menu-cols': g.items.length > 6 }]}>
                {g.items.map((l) => (
                  <a class="menu-item" href={l.href} aria-current={path === l.href ? 'page' : undefined}><strong>{l.label}</strong>{l.note && <span>{l.note}</span>}</a>
                ))}
              </div>
              {g.href && (
                <div class="menu-foot"><span class="muted">{menuNotes[g.label] ?? ''}</span><a href={g.href}>{g.allLabel ?? `All ${g.label.toLowerCase()}`} →</a></div>
              )}
            </div>
          </li>
        ) : (
          <li><a class:list={['nav-link', { highlight: g.highlight }]} href={g.href} aria-current={isCurrent(g.href) ? 'page' : undefined}>{g.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="btn btn-outline hdr-call" href={`tel:${site.phoneE164}`} title={`${site.phoneDisplay} · ${site.callHours}`}><Icon name="phone" size={18} />Call</a>
      <a class="btn btn-primary hdr-wa" href={waLink(site.whatsapp, waText)} rel="noopener" target="_blank"><Icon name="whatsapp" size={18} />WhatsApp</a>
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu"><Icon name="menu" size={22} /></button>
    </div>
  </div>
</header>

<div class="mnav" id="mnav" hidden role="dialog" aria-modal="true" aria-label="Menu">
  <div class="mnav-top">
    <Logo />
    <button class="icon-btn" type="button" data-close-menu aria-label="Close menu"><Icon name="close" size={22} /></button>
  </div>
  <div class="mnav-body">
    {mainNav.filter((g) => g.items).map((g) => (
      <details>
        <summary>{g.label}<Icon name="chevronDown" size={18} class="chev" /></summary>
        <ul>
          {g.items!.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {g.href && <li><a href={g.href}><strong>{g.allLabel ?? `All ${g.label.toLowerCase()}`} →</strong></a></li>}
        </ul>
      </details>
    ))}
    <details>
      <summary>Calculators and checklists<Icon name="chevronDown" size={18} class="chev" /></summary>
      <ul>{tools.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
    <details>
      <summary>Guides and help<Icon name="chevronDown" size={18} class="chev" /></summary>
      <ul>{resources.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
    <details>
      <summary>Company<Icon name="chevronDown" size={18} class="chev" /></summary>
      <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
    <div class="mnav-cta">
      <a class="btn btn-primary btn-lg" href={waLink(site.whatsapp, waText)} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />WhatsApp (any time)</a>
      <a class="btn btn-outline btn-lg" href={`tel:${site.phoneE164}`}><Icon name="phone" size={20} />Call {site.phoneDisplay}</a>
      <p class="small muted center">{site.callHours} · {site.whatsappHours} · {site.city}</p>
    </div>
  </div>
</div>

<script>
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.has-menu'));
  const closeAll = (except?: Element) => {
    items.forEach((li) => {
      if (li === except) return;
      li.classList.remove('open');
      li.querySelector('.nav-link')?.setAttribute('aria-expanded', 'false');
    });
  };
  items.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.nav-link');
    btn?.addEventListener('click', () => {
      const open = !li.classList.contains('open');
      closeAll(li);
      li.classList.remove('closed');
      li.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    li.addEventListener('mouseleave', () => li.classList.remove('closed'));
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-menu')) closeAll();
  });

  const mnav = document.getElementById('mnav');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const openMobile = () => {
    if (!mnav) return;
    mnav.hidden = false;
    document.body.classList.add('menu-open');
    toggle?.setAttribute('aria-expanded', 'true');
    mnav.querySelector<HTMLButtonElement>('[data-close-menu]')?.focus();
  };
  const closeMobile = () => {
    if (!mnav || mnav.hidden) return;
    mnav.hidden = true;
    document.body.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.focus();
  };
  toggle?.addEventListener('click', openMobile);
  mnav?.querySelector('[data-close-menu]')?.addEventListener('click', closeMobile);
  mnav?.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a');
    if (a && a.getAttribute('href')?.startsWith('#')) closeMobile();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openLi = items.find((li) => li.classList.contains('open') || li.matches(':focus-within'));
    if (openLi) {
      openLi.classList.remove('open');
      openLi.classList.add('closed');
      openLi.querySelector<HTMLButtonElement>('.nav-link')?.focus();
    }
    closeMobile();
  });
</script>
