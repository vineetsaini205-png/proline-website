---
import site from '../data/site.json';
import { mainNav, cms, tools, company } from '../data/nav';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { waLink } from '../lib/text';

interface Props { cta?: { label: string; href: string }; waText?: string }
const { cta = { label: 'Get a quote', href: '#quote' }, waText } = Astro.props;
const path = Astro.url.pathname;
// On phones under 400 px the header button gets a short label, so it fits beside the logo.
const shortLabels: Record<string, string> = {
  'Plan your station': 'Get a quote', 'Partner with us': 'Contact us', 'Become a brand partner': 'Contact us',
  'Ask your question': 'Ask us', 'Book a site survey': 'Book survey', 'Book a survey': 'Book survey', 'Book a demo': 'Book demo',
};
const short = shortLabels[cta.label];

const menuNotes: Record<string, string> = {
  Services: 'Not sure what you need? Start with a site survey.',
  Chargers: 'Brand-neutral advice on any charger brand.',
  'Who we serve': 'One team for every kind of site.',
};
const isCurrent = (href?: string) => !!href && href !== '/' && path.startsWith(href);
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="offer">
  <div class="wrap">
    <p><span class="dot" aria-hidden="true"></span>{site.offerStrip}</p>
    <p class="offer-hours">{site.callHours} · {site.whatsappHours} · <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a></p>
  </div>
</div>
<header class="site-header">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label="Main menu">
      <ul>
        {mainNav.map((g, i) => g.items ? (
          <li class="has-menu">
            <button class="nav-link" type="button" aria-expanded="false" aria-controls={`menu-${i}`}>{g.label}<Icon name="chevronDown" size={16} class="chev" /></button>
            <div class="menu" id={`menu-${i}`} style={g.items.length > 6 ? 'min-width: 560px' : undefined}>
              <div class:list={[{ 'menu-cols': g.items.length > 6 }]}>
                {g.items.map((l) => (
                  <a class="menu-item" href={l.href} aria-current={path === l.href ? 'page' : undefined}><strong>{l.label}</strong>{l.note && <span>{l.note}</span>}</a>
                ))}
              </div>
              {g.href && (
                <div class="menu-foot"><span class="muted">{menuNotes[g.label] ?? ''}</span><a href={g.href}>All {g.label.toLowerCase()} →</a></div>
              )}
            </div>
          </li>
        ) : (
          <li><a class:list={['nav-link', { highlight: g.highlight }]} href={g.href} aria-current={isCurrent(g.href) ? 'page' : undefined}>{g.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="icon-btn icon-call" href={`tel:${site.phoneE164}`} aria-label={`Call ${site.phoneDisplay} (${site.callHours.toLowerCase()})`}><Icon name="phone" size={20} /></a>
      <a class="btn btn-primary" href={cta.href}>{short ? <><span class="cta-long">{cta.label}</span><span class="cta-short">{short}</span></> : cta.label}</a>
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu"><Icon name="menu" size={22} /></button>
    </div>
  </div>
</header>

<div class="mnav" id="mnav" hidden role="dialog" aria-modal="true" aria-label="Menu">
  <div class="mnav-top">
    <Logo />
    <button class="icon-btn" type="button" data-close-menu aria-label="Close menu"><Icon name="close" size={22} /></button>
  </div>
  <div class="mnav-body">
    {mainNav.filter((g) => g.items).map((g) => (
      <details>
        <summary>{g.label}<Icon name="chevronDown" size={18} class="chev" /></summary>
        <ul>
          {g.items!.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {g.href && <li><a href={g.href}><strong>All {g.label.toLowerCase()} →</strong></a></li>}
        </ul>
      </details>
    ))}
    <details>
      <summary><span style="display:flex;align-items:center;gap:8px"><span class="dot"></span>Proline CMS</span><Icon name="chevronDown" size={18} class="chev" /></summary>
      <ul>{cms.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
    <details>
      <summary>Tools<Icon name="chevronDown" size={18} class="chev" /></summary>
      <ul>{tools.map((l) => <li><a href={l.href}>{l.label}</a></li>)}<li><a href="/tools/"><strong>All tools →</strong></a></li></ul>
    </details>
    <details>
      <summary>Company<Icon name="chevronDown" size={18} class="chev" /></summary>
      <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
    <div class="mnav-cta">
      <a class="btn btn-primary btn-lg" href={cta.href} data-close-menu-link>{cta.label}</a>
      <a class="btn btn-outline btn-lg" href={waLink(site.whatsapp, waText)} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />WhatsApp (any time)</a>
      <a class="btn btn-outline btn-lg" href={`tel:${site.phoneE164}`}><Icon name="phone" size={20} />Call {site.phoneDisplay}</a>
      <p class="small muted center">{site.callHours} · {site.whatsappHours} · {site.city}</p>
    </div>
  </div>
</div>

<script>
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.has-menu'));
  const closeAll = (except?: Element) => {
    items.forEach((li) => {
      if (li === except) return;
      li.classList.remove('open');
      li.querySelector('.nav-link')?.setAttribute('aria-expanded', 'false');
    });
  };
  items.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.nav-link');
    btn?.addEventListener('click', () => {
      const open = !li.classList.contains('open');
      closeAll(li);
      li.classList.remove('closed');
      li.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    li.addEventListener('mouseleave', () => li.classList.remove('closed'));
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-menu')) closeAll();
  });

  const mnav = document.getElementById('mnav');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const openMobile = () => {
    if (!mnav) return;
    mnav.hidden = false;
    document.body.classList.add('menu-open');
    toggle?.setAttribute('aria-expanded', 'true');
    mnav.querySelector<HTMLButtonElement>('[data-close-menu]')?.focus();
  };
  const closeMobile = () => {
    if (!mnav || mnav.hidden) return;
    mnav.hidden = true;
    document.body.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.focus();
  };
  toggle?.addEventListener('click', openMobile);
  mnav?.querySelector('[data-close-menu]')?.addEventListener('click', closeMobile);
  mnav?.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a');
    if (a && a.getAttribute('href')?.startsWith('#')) closeMobile();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openLi = items.find((li) => li.classList.contains('open') || li.matches(':focus-within'));
    if (openLi) {
      openLi.classList.remove('open');
      openLi.classList.add('closed');
      openLi.querySelector<HTMLButtonElement>('.nav-link')?.focus();
    }
    closeMobile();
  });
</script>
