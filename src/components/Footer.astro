---
// Compact footer (owner, 24 Oct: less crowded).
import site from '../data/site.json';
import { tools } from '../data/nav';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { waLink } from '../lib/text';
const year = new Date().getFullYear();
// Strategy plan (13 Nov 2026): four columns that follow the menu; background pages (batteries, solar,
// white-label, government, technicians) live here rather than in the header.
const cols = [
  { title: 'Choose a charger', links: [
    { label: 'Help me choose', href: '/chargers/#help-me-choose' },
    { label: 'Chargers for your car', href: '/chargers/for/' },
    { label: 'AC and home chargers', href: '/chargers/ac-chargers/' },
    { label: 'DC fast chargers', href: '/chargers/dc-fast-chargers/' },
    { label: '2W and 3W chargers', href: '/chargers/2w-3w-chargers/' },
    { label: 'White-label chargers', href: '/chargers/white-label-chargers/' },
    { label: 'Batteries', href: '/batteries/' },
  ] },
  { title: 'Commercial and installation', links: [
    { label: 'Plan a charging station', href: '/start-an-ev-charging-station/' },
    { label: 'Fleets', href: '/for/fleets/' },
    { label: 'Housing societies', href: '/for/housing-societies/' },
    { label: 'Businesses', href: '/for/businesses/' },
    { label: 'EV charger installation', href: '/services/ev-charger-installation/' },
    { label: 'Site survey', href: '/services/site-survey/' },
    { label: 'AMC and maintenance', href: '/services/ev-charger-amc/' },
    { label: 'Solar + EV charging', href: '/solar-ev-charging/' },
  ] },
  { title: 'Brands and software', links: [
    { label: 'For charger brands', href: '/for/charger-brands/' },
    { label: 'EV makers and dealers', href: '/for/ev-makers-and-dealers/' },
    { label: 'Government and PSUs', href: '/for/government-and-psu/' },
    { label: 'Proline CMS', href: '/cms/' },
    { label: 'Request a CMS demo', href: '/cms/demo/' },
    ...tools.map((t) => ({ label: t.label, href: t.href })),
  ] },
  { title: 'Company', links: [
    { label: 'Our work', href: '/projects/' },
    { label: 'About Proline', href: '/about/' },
    { label: 'Contact', href: '/contact/' },
    { label: 'Coverage', href: '/coverage/' },
    { label: 'Blog', href: '/blog/' },
    { label: 'FAQ', href: '/faq/' },
    { label: 'Join as a technician', href: '/join-as-technician/' },
  ] },
];
---
<footer class="site-footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <Logo variant="white" lazy />
      <p>Charger advice across brands, tie-up quotes and site installation. Based in {site.city}, working across India. We visit your site; there is no showroom or walk-in office.</p>
      <p class="footer-phone"><a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a><span>{site.callHours} · {site.whatsappHours}</span></p>
      <div class="footer-actions">
        <a class="fbtn" href={waLink(site.whatsapp)} rel="noopener" target="_blank"><Icon name="whatsapp" size={16} />WhatsApp us</a>
        <a class="fbtn" href={`tel:${site.phoneE164}`}><Icon name="phone" size={16} />Call 10 am–7 pm</a>
        <a class="fbtn" href={`mailto:${site.email}`}><Icon name="mail" size={16} />Email</a>
      </div>
    </div>
    {cols.map((c) => (
      <details class="footer-col" open>
        <summary><h2>{c.title}</h2></summary>
        <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </details>
    ))}
  </div>
  <div class="footer-bottom">
    <div class="wrap">
      <p>© {year} {site.name}, {site.city}. Brand names belong to their owners.</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>
<script is:inline>
  // Phones: the four link groups start closed (tap to open); wider screens keep them open.
  (function () {
    var mq = window.matchMedia('(max-width: 760px)');
    var cols = document.querySelectorAll('.site-footer details.footer-col');
    function sync() { cols.forEach(function (d) { d.open = !mq.matches; }); }
    sync();
    if (mq.addEventListener) mq.addEventListener('change', sync);
    cols.forEach(function (d) { d.addEventListener('toggle', function () { if (!mq.matches && !d.open) d.open = true; }); });
  })();
</script>
