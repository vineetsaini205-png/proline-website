---
// FAQ list. Answers may contain simple Markdown-style links: [text](/url/) and **bold**.
import Icon from './Icon.astro';
import { inlineMd } from '../lib/text';
export interface FaqItem { q: string; a: string }
// show: on long lists, how many questions to show before a "Show N more questions" fold
// (the rest stay in the page, and in the FAQ schema, for Google).
interface Props { items: FaqItem[]; open?: boolean; show?: number }
const { items, open = false, show } = Astro.props;
const cut = show && items.length > show + 2 ? show : items.length;
const first = items.slice(0, cut);
const rest = items.slice(cut);
---
<div class="faqs">
  {first.map((f, i) => (
    <details class="faq" open={open && i === 0 ? true : undefined}>
      <summary><span>{f.q}</span><span class="plus" aria-hidden="true"><Icon name="plus" size={16} stroke={2.5} /></span></summary>
      <div class="faq-a">{f.a.split(/\n\s*\n/).map((p) => <p set:html={inlineMd(p)} />)}</div>
    </details>
  ))}
  {rest.length > 0 && (
    <details class="faq-more">
      <summary class="btn btn-outline">Show {rest.length} more questions<Icon name="chevronDown" size={18} /></summary>
      <div class="faqs">
        {rest.map((f) => (
          <details class="faq">
            <summary><span>{f.q}</span><span class="plus" aria-hidden="true"><Icon name="plus" size={16} stroke={2.5} /></span></summary>
            <div class="faq-a">{f.a.split(/\n\s*\n/).map((p) => <p set:html={inlineMd(p)} />)}</div>
          </details>
        ))}
      </div>
    </details>
  )}
</div>
