---
// Contact block at the end of most pages: heading, one line, WhatsApp and Call buttons, the form.
// (Owner, 25 Oct: the three contact rows became two buttons and one short note.)
import site from '../data/site.json';
import Icon from './Icon.astro';
import QuoteForm, { type FormVariant } from './QuoteForm.astro';
import { waLink } from '../lib/text';
interface Props {
  title?: string;
  lead?: string;
  variant?: FormVariant;
  need?: string;
  formTitle?: string;
  waText?: string;
  navy?: boolean;
}
const {
  title = 'Tell us about your site',
  lead = 'Share a few details and we come back with the right charger options and one clear quote. Choosing a charger? The advice is free, for any brand.',
  variant = 'quote', need, formTitle, waText, navy = true,
} = Astro.props;
---
<section class:list={['section cta-band', navy ? 'section-navy' : 'section-soft']} id="quote" aria-labelledby="quote-title">
  <div class="wrap">
    <div class="cta-copy">
      <p class="eyebrow-plain">Talk to Proline</p>
      <h2 id="quote-title">{title}</h2>
      <p class="lead">{lead}</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href={waLink(site.whatsapp, waText)} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />WhatsApp us</a>
        <a class:list={['btn', navy ? 'btn-ghost-light' : 'btn-outline']} href={`tel:${site.phoneE164}`}><Icon name="phone" size={18} />Call 10 am–7 pm</a>
      </div>
      <p class="cta-note">WhatsApp any time. Photos of your site and meter help us reply faster. For tenders, documents and drawings: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <QuoteForm variant={variant} need={need} title={formTitle} id="quote-form" />
  </div>
</section>
