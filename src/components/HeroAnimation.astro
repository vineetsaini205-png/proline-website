<style is:global>
  .ha { container-type: inline-size; --ha-ease: cubic-bezier(.22, 1, .36, 1); color: var(--navy); }
  /* Owner, 15 Nov: smaller, and part of the page background rather than a card. */
  .ha-box { background: transparent; isolation: isolate; }
  .ha-stage { position: relative; aspect-ratio: 1.8; max-height: 400px; width: 100%; overflow: hidden; background: radial-gradient(ellipse 58% 52% at 60% 64%, rgba(19, 178, 107, .13), rgba(19, 178, 107, 0) 72%); }
  .ha-picture { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; display: block; overflow: visible; }
  .ha-copy { position: absolute; z-index: 2; top: 30px; left: 34px; pointer-events: none; }
  .ha-eyebrow { display: flex; align-items: center; gap: 9px; font-size: 11px; letter-spacing: .14em; font-weight: 700; color: var(--green-text); text-transform: uppercase; margin-bottom: 12px; }
  .ha-eyebrow::before { content: ""; width: 17px; height: 1px; background: currentColor; }
  .ha-title { font-family: var(--font-head); font-size: clamp(28px, 4cqi, 42px); line-height: 1.06; letter-spacing: -0.03em; font-weight: 600; color: var(--navy); max-width: 340px; }
  .ha-line { display: block; }
  .ha-sub { margin-top: 12px; font-size: 13px; line-height: 1.5; color: #4f6560; }
  .ha-spec { position: absolute; z-index: 2; top: 32px; right: 34px; text-align: right; pointer-events: none; }
  .ha-spec-label { display: block; font-size: 10px; font-weight: 600; letter-spacing: .14em; color: #5d706b; text-transform: uppercase; margin-bottom: 8px; }
  .ha-spec-value { display: block; font-size: 24px; font-weight: 600; letter-spacing: -0.02em; color: var(--navy); font-variant-numeric: tabular-nums; }
  .ha-spec-value small { font-size: 12px; margin-left: 3px; letter-spacing: 0; }
  .ha-status { position: absolute; bottom: 24px; left: 34px; display: flex; align-items: center; gap: 8px; font-size: 11px; color: #3f5f52; }
  .ha-dot { width: 6px; height: 6px; border-radius: 50%; background: #0ba56b; box-shadow: 0 0 0 4px #0ba56b14; animation: ha-pulse 3s ease-in-out infinite; }
  .ha-mark { position: absolute; bottom: 22px; right: 34px; font-size: 10px; letter-spacing: .14em; line-height: 1.7; color: #6f8178; text-transform: uppercase; text-align: right; }
  .ha-mark b { color: #3f5f52; font-weight: 600; }
  .ha-copy.is-changing, .ha-spec.is-changing { animation: ha-copy-in .6s var(--ha-ease); }

  .ha-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: transparent; border-top: 1px solid var(--line); padding: 0; }
  .ha-btn { position: relative; display: flex; align-items: center; gap: 12px; background: none; border: 0; border-right: 1px solid var(--line); margin: 10px 0; padding: 4px 16px 6px; text-align: left; color: #5f6f6c; transition: color .3s; min-height: 48px; }
  .ha-btn:last-child { border-right: 0; }
  .ha-btn[aria-pressed="true"] { color: var(--navy); }
  .ha-btn:hover { color: var(--green-text); }
  .ha-icon { width: 33px; height: 33px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; flex: none; transition: all .3s; }
  .ha-icon svg { width: 17px; height: 17px; }
  .ha-btn[aria-pressed="true"] .ha-icon { background: var(--green-50); border-color: #d8ebdf; color: var(--green-text); }
  .ha-name { display: block; font-size: 13px; font-weight: 600; line-height: 1.4; }
  .ha-detail { display: block; margin-top: 3px; font-size: 11.5px; color: #66766f; }
  .ha-progress { position: absolute; bottom: -10px; left: 16px; right: 16px; height: 2px; overflow: hidden; }
  .ha-progress span { display: block; width: 100%; height: 100%; background: var(--green-text); transform-origin: left; transform: scaleX(0); }
  .ha-btn[aria-pressed="true"] .ha-progress span { transform: scaleX(var(--progress, 0)); }

  .ha-below { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 6px 0 0; border-top: 1px solid var(--line); }
  .ha-foot { font-size: 12px; color: var(--muted); line-height: 1.45; }
  .ha-pause { flex: none; display: flex; align-items: center; gap: 6px; background: transparent; border: 0; color: #3f5f52; border-radius: 30px; padding: 6px 4px 6px 10px; font-size: 12px; min-height: 32px; }
  .ha-pause:hover { background: var(--soft); }
  .ha-pause svg { width: 12px; height: 12px; }
  .ha-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .ha-sg { opacity: 0; transform: translateY(12px); transition: opacity .9s var(--ha-ease), transform 1.2s var(--ha-ease); pointer-events: none; }
  .ha-sg.is-active { opacity: 1; transform: translateY(0); }
  .ha-arch { opacity: 0; transition: opacity 1.4s ease; }
  .ha-arch.is-active { opacity: 1; }
  .ha-energy { fill: none; stroke: #38d49c; stroke-linecap: round; stroke-width: 2.3; stroke-dasharray: 2 25; animation: ha-flow 3s linear infinite; }
  .ha-energy-glow { fill: none; stroke: #26c790; stroke-width: 7; opacity: .3; filter: url(#ha-soft-glow); stroke-dasharray: 3 35; animation: ha-flow 3s linear infinite; }
  .ha-energy-road { fill: none; stroke: #25b47e; stroke-width: 1.3; stroke-dasharray: 22 290; animation: ha-road 6s linear infinite; opacity: .6; }
  .ha-ring { fill: none; stroke: #58bb8e; stroke-width: 1; transform-box: fill-box; transform-origin: center; animation: ha-halo 4s ease-out infinite; }
  .ha-ring-2 { animation-delay: 2s; }
  .ha-light { animation: ha-led 3.2s ease-in-out infinite; }
  .ha-batt { animation: ha-batt 9s ease-in-out infinite; }
  .ha-batt:nth-child(2) { animation-delay: .55s; } .ha-batt:nth-child(3) { animation-delay: 1.1s; } .ha-batt:nth-child(4) { animation-delay: 1.65s; } .ha-batt:nth-child(5) { animation-delay: 2.2s; }
  .ha-ambient { animation: ha-ambient 6s ease-in-out infinite; }
  .ha.is-paused * { animation-play-state: paused !important; }
  .ha.is-still * { animation: none !important; transition: none !important; }
  .ha.is-still .ha-batt { opacity: .85; }
  @keyframes ha-flow { to { stroke-dashoffset: -108; } }
  @keyframes ha-road { to { stroke-dashoffset: -624; } }
  @keyframes ha-halo { 0% { transform: scale(.75); opacity: 0; } 15% { opacity: .35; } 100% { transform: scale(1.45); opacity: 0; } }
  @keyframes ha-led { 0%, 100% { opacity: .65; } 50% { opacity: 1; } }
  @keyframes ha-batt { 0%, 20% { opacity: .22; } 40%, 80% { opacity: 1; } 100% { opacity: .22; } }
  @keyframes ha-pulse { 0%, 100% { box-shadow: 0 0 0 4px #0ba56b14; } 50% { box-shadow: 0 0 0 6px #0ba56b08; } }
  @keyframes ha-ambient { 0%, 100% { opacity: .2; transform: translateY(0); } 50% { opacity: .6; transform: translateY(-9px); } }
  @keyframes ha-copy-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  @container (max-width: 760px) {
    .ha-stage { aspect-ratio: 1.7; }
    .ha-picture { top: auto; bottom: 4px; height: 80%; }
    .ha-copy { left: 4px; top: 10px; }
    .ha-spec { right: 4px; top: 12px; }
    .ha-eyebrow { font-size: 10px; letter-spacing: .1em; margin-bottom: 8px; }
    .ha-title { font-size: 25px; }
    .ha-sub { font-size: 12px; margin-top: 6px; max-width: 240px; }
    .ha-spec-label { font-size: 9.5px; letter-spacing: .08em; margin-bottom: 4px; }
    .ha-spec-value { font-size: 19px; }
    .ha-status { left: 4px; bottom: 6px; font-size: 10.5px; }
    .ha-mark { display: none; }
    .ha-btn { padding-left: 10px; padding-right: 10px; gap: 9px; }
    .ha-btn:first-child { padding-left: 0; }
    .ha-icon { width: 28px; height: 28px; }
    .ha-icon svg { width: 15px; height: 15px; }
    .ha-name { font-size: 12.5px; }
    .ha-detail { font-size: 11px; }
    .ha-progress { left: 10px; right: 10px; }
    .ha-btn:first-child .ha-progress { left: 0; }
  }
  @container (max-width: 420px) {
    .ha-stage { aspect-ratio: 1.2; }
    .ha-picture { height: 72%; bottom: 26px; }
    .ha-title { font-size: 24px; max-width: 230px; }
    .ha-sub { font-size: 11.5px; max-width: 200px; }
    .ha-spec { top: auto; bottom: 4px; }
    .ha-status { bottom: 8px; }
    .ha-btn { flex-direction: column; align-items: flex-start; gap: 6px; padding: 2px 8px 6px; }
    .ha-name { font-size: 12px; }
    .ha-detail { font-size: 10.5px; line-height: 1.35; }
    .ha-progress { left: 8px; right: 8px; }
  }
  @container (max-width: 330px) {
    .ha-stage { aspect-ratio: 1.05; }
    .ha-title { font-size: 22px; }
    .ha-name { font-size: 11px; }
    .ha-detail { font-size: 10px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ha]');
  if (root) {
    const scenes = [
      { eyebrow: 'Made for your everyday', lines: ['Come home.', 'Plug in.'], sub: 'A simpler start to your next journey.', label: 'Home & office · AC', value: '7.4 / 11' },
      { eyebrow: 'Make every stop count', lines: ['While you work,', 'we power.'], sub: 'Put your parking time to work.', label: 'Workplace charging · AC', value: '22' },
      { eyebrow: 'Powering commercial journeys', lines: ['Power your', 'business.'], sub: 'For fleets and commercial sites.', label: 'Commercial charging · DC', value: '60 / 120' },
    ];
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.ha-btn')];
    const groups = [...root.querySelectorAll('[data-scene]')];
    const arch = [...root.querySelectorAll('[data-architecture]')];
    const pause = q<HTMLButtonElement>('[data-ha-pause]');
    const mq = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0, elapsed = 0, last = 0, frame = 0, paused = mq.matches, inView = true;
    const duration = 10500;
    if (paused) root.classList.add('is-still');
    const homeCable = 'M324 356C355 360 326 429 367 447S436 436 450 405L487 367';
    const dcCable = 'M354 350C386 357 348 433 384 447S442 428 460 398L487 367';

    function select(i: number, announce = false, animate = true) {
      current = i; elapsed = 0;
      const s = scenes[i];
      buttons.forEach((b, j) => { b.setAttribute('aria-pressed', String(j === i)); b.style.setProperty('--progress', '0'); });
      groups.forEach((g, j) => g.classList.toggle('is-active', j === i));
      arch.forEach((g, j) => g.classList.toggle('is-active', j === i));
      q('[data-ha-eyebrow]').textContent = s.eyebrow;
      q('[data-ha-title]').replaceChildren(...s.lines.map((t) => { const e = document.createElement('span'); e.className = 'ha-line'; e.textContent = t; return e; }));
      q('[data-ha-sub]').textContent = s.sub;
      q('[data-ha-spec-label]').textContent = s.label;
      q('[data-ha-spec-value]').textContent = s.value;
      root.querySelectorAll('[data-energy-cable]').forEach((p) => p.setAttribute('d', i === 2 ? dcCable : homeCable));
      q('#ha-charger-connector').setAttribute('d', i === 2 ? 'm354 348 3 12' : 'm324 354 3 12');
      // Not on the first call: a paused (off-screen) fade-in would leave the text invisible.
      if (animate && !paused) for (const sel of ['[data-ha-copy]', '[data-ha-spec]']) { const el = q(sel); el.classList.remove('is-changing'); void el.offsetWidth; el.classList.add('is-changing'); }
      if (announce) q('[data-ha-announce]').textContent = `${s.label}, ${s.value} kilowatts.`;
    }
    function tick(now: number) {
      if (paused || document.hidden || !inView) { frame = 0; return; }
      if (last) elapsed += Math.min(now - last, 100);
      last = now;
      if (elapsed >= duration) select((current + 1) % scenes.length);
      buttons[current].style.setProperty('--progress', String(Math.min(elapsed / duration, 1)));
      frame = requestAnimationFrame(tick);
    }
    function sync() {
      const stopped = paused || document.hidden || !inView;
      root!.classList.toggle('is-paused', stopped);
      pause.setAttribute('aria-label', paused ? 'Play animation' : 'Pause animation');
      q('[data-ha-pause-text]').textContent = paused ? 'Play' : 'Pause';
      q('[data-ha-pause-icon]').innerHTML = paused ? '<path d="m5 2 9 6-9 6z"/>' : '<path d="M4 3h3v10H4zm5 0h3v10H9z"/>';
      if (frame) { cancelAnimationFrame(frame); frame = 0; }
      last = 0;
      if (!stopped) frame = requestAnimationFrame(tick);
    }
    buttons.forEach((b, i) => b.addEventListener('click', () => select(i, true)));
    pause.addEventListener('click', () => { paused = !paused; root.classList.remove('is-still'); sync(); });
    document.addEventListener('visibilitychange', sync);
    mq.addEventListener('change', (e) => { paused = e.matches; root.classList.toggle('is-still', e.matches); sync(); });
    if ('IntersectionObserver' in window) new IntersectionObserver((en) => { inView = en[0].isIntersecting; sync(); }, { threshold: 0.05 }).observe(root);
    select(0, false, false); sync();
  }
</script>
