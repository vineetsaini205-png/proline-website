---
import { cms } from '../../data/nav';
const path = Astro.url.pathname;
---
<nav class="cms-nav" aria-label="Proline CMS pages">
  <div class="wrap">
    <ul>
      {cms.map((l) => <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label === 'Proline CMS overview' ? 'Overview' : l.label}</a></li>)}
    </ul>
  </div>
</nav>
<style>
  .cms-nav { background: var(--white); border-bottom: 1px solid var(--line); position: sticky; top: var(--header-h); z-index: 30; }
  .cms-nav ul { list-style: none; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; padding: 6px 0; }
  .cms-nav ul::-webkit-scrollbar { display: none; }
  .cms-nav a { display: block; white-space: nowrap; padding: 9px 14px; border-radius: 999px; font-size: 14.5px; font-weight: 600; color: var(--body); text-decoration: none; }
  .cms-nav a:hover { background: var(--soft); color: var(--ink); }
  .cms-nav a[aria-current="page"] { background: var(--navy); color: var(--white); }
  /* Phones: scrolls away with the page, so only the header stays on screen (owner, 25 Oct) */
  @media (max-width: 760px) { .cms-nav { position: static; } }
</style>
