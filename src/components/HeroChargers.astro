---
// Home hero picture (owner, 15 Nov: replace the site photo with an animated picture of many charger types).
// A drawn scene, not a photo: wall boxes on a home/office wall on the left, a charging station under a canopy on
// the right. Gentle motion only (canopy lights, a power line, glows under the chargers); none with reduced motion.
import ChargerArt from './ChargerArt.astro';
import { chargerTypes, type ChargerKind } from '../data/charger-types';

// x = centre (% of width), b = bottom (% of height), h = height (% of height). Art frames are 200 x 240.
const items: { kind: ChargerKind; x: number; b: number; h: number; kw: string; type: string; wall?: boolean }[] = [
  { kind: 'wallbox-7', x: 7.5, b: 30, h: 32, kw: '7.4 kW', type: 'AC', wall: true },
  { kind: 'wallbox-11', x: 20.5, b: 30, h: 32, kw: '11 kW', type: 'AC', wall: true },
  { kind: 'ac-post-22', x: 35.5, b: 16, h: 44, kw: '22 kW', type: 'AC' },
  { kind: 'lev-dc', x: 48.5, b: 16, h: 30, kw: '2W/3W', type: 'DC' },
  { kind: 'dc-60', x: 63.5, b: 16, h: 52, kw: '60 kW', type: 'DC' },
  { kind: 'dc-120', x: 85.5, b: 16, h: 58, kw: '120 kW', type: 'DC' },
];
const name = (k: ChargerKind) => chargerTypes.find((t) => t.kind === k)!;
const lights = [36, 46, 56, 66, 76, 86, 94];
---
<figure class="hc">
  <div class="hc-scene" role="group" aria-label="Drawing of the charger types we supply and install: 7.4 kW and 11 kW wall boxes, a 22 kW AC charging post, a DC charger for scooters and 3-wheelers, and 60 kW and 120 kW DC fast chargers">
    <div class="hc-sky"></div>
    <div class="hc-wall"><span class="hc-zone">Homes and offices</span></div>
    <div class="hc-canopy"><span class="hc-zone hc-zone-light">Charging stations</span>{lights.map((l, i) => <i class="hc-light" style={`left:${(l - 28) / 0.7}%;animation-delay:${i * 0.35}s`}></i>)}</div>
    <div class="hc-pillar" style="left:30%"></div><div class="hc-pillar" style="left:96%"></div>
    <div class="hc-ground"><i class="hc-lane"></i></div>
    <svg class="hc-power" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M2 5 H98" /></svg>
    {items.map((it, i) => (
      <a class:list={['hc-item', { 'hc-wallunit': it.wall }]} href={name(it.kind).href} aria-label={`${name(it.kind).name}: see details`}
         style={`left:${it.x}%;bottom:${it.b}%;height:${it.h}%;--d:${i * 0.4}s`}>
        {!it.wall && <i class="hc-glow"></i>}
        <ChargerArt kind={it.kind} label={`Drawing of a typical ${name(it.kind).name.toLowerCase()}`} bare />
      </a>
    ))}
    {items.map((it) => (
      <span class="hc-tag" style={`left:${it.x}%;bottom:${it.wall ? 21 : 2.5}%`} aria-hidden="true">{it.kw}<span class="hc-type">{it.type}</span></span>
    ))}
  </div>
  <figcaption>Chargers we supply and install, from wall boxes for homes and offices to DC fast chargers for stations. Typical designs; we suggest the exact brand and model for your site.</figcaption>
</figure>

<style>
  .hc { margin: 0; }
  .hc-scene { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-xl); border: 1px solid var(--line); background: #EEF4F9; isolation: isolate; }
  .hc-sky { position: absolute; inset: 0; background: radial-gradient(circle at 82% 18%, rgba(19, 178, 107, .16), transparent 34%), linear-gradient(180deg, #E3EEF7 0%, #F3F6F4 70%); }
  .hc-wall { position: absolute; left: 0; bottom: 17%; width: 27%; height: 74%; background: #FFFFFF; border-right: 2px solid #D3DDE7; box-shadow: inset 0 -1px 0 #D3DDE7;
             background-image: linear-gradient(#EEF3F8 1px, transparent 1px); background-size: 100% 12%; }
  .hc-zone { position: absolute; left: 8%; top: 5%; font-size: clamp(9px, 1.15vw, 12.5px); font-weight: 600; color: var(--navy); white-space: nowrap; }
  .hc-canopy { position: absolute; left: 28%; right: 0; top: 7%; height: 7.5%; background: var(--navy); border-radius: 6px 0 0 6px; box-shadow: 0 6px 14px rgba(11, 37, 69, .18); }
  .hc-zone-light { color: #fff; left: 3%; top: 50%; transform: translateY(-50%); }
  .hc-light { position: absolute; bottom: -3px; width: 7px; height: 7px; margin-left: -3.5px; border-radius: 50%; background: #FFF6D6; box-shadow: 0 0 10px 4px rgba(255, 238, 170, .55); animation: hc-twinkle 3.2s ease-in-out infinite; }
  .hc-pillar { position: absolute; top: 14%; bottom: 17%; width: 1.4%; margin-left: -0.7%; background: linear-gradient(90deg, #C9D3DE, #E4EAF0); }
  .hc-ground { position: absolute; left: 0; right: 0; bottom: 0; height: 17%; background: linear-gradient(180deg, #CBD6D0, #DCE3DF); border-top: 2px solid #B9C6BF; }
  .hc-lane { position: absolute; left: 30%; right: 2%; top: 58%; height: 3px; background: repeating-linear-gradient(90deg, #E3B23C 0 18px, transparent 18px 32px); opacity: .8; }
  .hc-power { position: absolute; left: 0; right: 0; bottom: 15.5%; width: 100%; height: 3%; overflow: visible; }
  .hc-power path { fill: none; stroke: #0B7D4A; stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-dasharray: 6 9; animation: hc-flow 2.2s linear infinite; opacity: .75; }
  .hc-item { position: absolute; transform: translateX(-50%); aspect-ratio: 200 / 240; display: block; z-index: 2; transition: transform .2s; }
  .hc-item:hover, .hc-item:focus-visible { transform: translateX(-50%) translateY(-3px); }
  .hc-item :global(svg.charger-art) { width: 100%; height: 100%; }
  .hc-glow { position: absolute; left: 18%; right: 18%; bottom: -2%; height: 8%; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(19, 178, 107, .55), rgba(19, 178, 107, 0) 70%); animation: hc-pulse 2.8s ease-in-out infinite; animation-delay: var(--d); z-index: -1; }
  .hc-tag { position: absolute; transform: translateX(-50%); z-index: 3; display: flex; flex-direction: column; align-items: center; padding: 2px 7px 3px; border-radius: 6px; background: #fff; border: 1px solid var(--line-strong); font-size: clamp(9px, 1.05vw, 12.5px); line-height: 1.15; font-weight: 700; color: var(--navy); white-space: nowrap; box-shadow: 0 2px 6px rgba(11, 37, 69, .08); }
  .hc-type { font-size: .8em; font-weight: 600; color: var(--green-text); }
  .hc figcaption { margin-top: 8px; font-size: 14px; color: var(--muted); }
  @keyframes hc-twinkle { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
  @keyframes hc-flow { to { stroke-dashoffset: -30; } }
  @keyframes hc-pulse { 0%, 100% { opacity: .35; transform: scaleX(.85); } 50% { opacity: 1; transform: scaleX(1.05); } }
  @media (max-width: 520px) { .hc-tag { padding: 1px 5px 2px; } }
  @media (prefers-reduced-motion: reduce) { .hc-light, .hc-power path, .hc-glow { animation: none; } }
</style>
