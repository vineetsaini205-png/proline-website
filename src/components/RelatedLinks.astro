---
import { linkInfo, type NavLink } from '../data/nav';
import Icon from './Icon.astro';
interface Props { links: (string | NavLink)[]; title?: string }
const { links, title = 'Related pages' } = Astro.props;
const items = links
  .map((l) => (typeof l === 'string' ? linkInfo(l) ?? { label: l, href: l } : l))
  .filter(Boolean) as NavLink[];
---
{items.length > 0 && (
  <section class="section section-line" aria-labelledby="related-title">
    <div class="wrap">
      <h2 id="related-title" style="font-size:clamp(22px,2.4vw,28px);margin-bottom:24px">{title}</h2>
      <div class="grid grid-3">
        {items.map((l) => (
          <a class="card" href={l.href}>
            <h3>{l.label}</h3>
            {l.note && <p>{l.note}</p>}
            <span class="card-cta">Read more<Icon name="arrowRight" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
