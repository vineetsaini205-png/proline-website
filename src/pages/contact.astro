---
import SimplePage from '../layouts/SimplePage.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SectionHead from '../components/SectionHead.astro';
import Faqs from '../components/Faqs.astro';
import site from '../data/site.json';
import { waLink } from '../lib/text';
const faqs = [
  { q: 'What is the fastest way to reach you?', a: `WhatsApp us any time, with the WhatsApp button on any page. Send photos of your meter, main DB and the parking spot, and the charger you have in mind, and we can often tell you what the job needs straight away.` },
  { q: 'When can I call?', a: `Calls are answered from 10 am to 7 pm: tap Call on any page. Outside those hours, WhatsApp us and we reply.` },
  { q: 'Do you charge for a site survey?', a: 'Yes, the site survey is paid. If you go ahead with Proline, the survey fee is adjusted against your order.' },
  { q: 'Where are you based?', a: `In ${site.city}. Our technicians travel to sites across 10 states: Delhi, Haryana, Uttar Pradesh, Uttarakhand, Himachal Pradesh, Maharashtra, Madhya Pradesh, Chhattisgarh, Telangana and Tamil Nadu.` },
];
---
<SimplePage
  title="Contact Proline Electrical Works"
  description="Call, WhatsApp or send your requirements for charger advice, installation, partnerships or a CMS demonstration. Delhi-based; we visit your site."
  h1="Contact Proline"
  eyebrow="Contact"
  crumb="Contact"
  lead="Choose what your enquiry is about, then WhatsApp us any time, call between 10 am and 7 pm, or send the short form. We visit your site: there is no showroom or walk-in office."
  cta={false} faqs={faqs} headerCta={{ label: 'Get a quote', href: '#quote' }}>
  <section class="section" id="quote">
    <div class="wrap cta-split">
      <div>
        <h2 class="ctype-h">What is your enquiry about?</h2>
        <ul class="ctype-list" role="list">
          <li><a href="#quote-form"><Icon name="car" size={20} />A charger for my vehicle <span>Use the form on this page</span></a></li>
          <li><a href="/start-an-ev-charging-station/#quote"><Icon name="station" size={20} />A commercial charging site <span>Fleet, society, business or station</span></a></li>
          <li><a href="/for/charger-brands/#quote"><Icon name="plug" size={20} />An installation partnership <span>For charger brands and EV makers</span></a></li>
          <li><a href="/cms/demo/"><Icon name="grid" size={20} />A Proline CMS demo <span>For station owners and operators</span></a></li>
        </ul>
        <ul class="contact-list" style="margin-top:28px">
          <li><span class="ci"><Icon name="whatsapp" size={22} /></span><div><strong><a href={waLink(site.whatsapp, 'Hello Proline, I would like to talk about EV charging.')} rel="noopener" target="_blank">WhatsApp us</a></strong><span>Any time. Photos of your meter, DB and parking spot help.</span></div></li>
          <li><span class="ci"><Icon name="phone" size={22} /></span><div><strong><a href={`tel:${site.phoneE164}`}>Call us</a></strong><span>10 am–7 pm</span></div></li>
          <li><span class="ci"><Icon name="mail" size={22} /></span><div><strong><a href={`mailto:${site.email}`}>{site.email}</a></strong><span>Tenders, drawings, documents and brand partnerships</span></div></li>
          <li><span class="ci"><Icon name="map" size={22} /></span><div><strong>{site.city}, India</strong><span>Working across 10 states in North, South and West India</span></div></li>
        </ul>
        <div class="note" style="margin-top:28px"><strong>What happens next.</strong> We reply on WhatsApp or by phone, ask for photos of your parking, meter and main DB if we need them, and send our tie-up quote with the full scope. Site surveys are paid, and the fee is adjusted against your order if you go ahead with Proline.</div>
      </div>
      <QuoteForm variant="quote" id="quote-form" vehicleRequired={false} />
    </div>
  </section>
  <section class="section section-soft" aria-labelledby="faq-title">
    <div class="wrap-narrow">
      <SectionHead eyebrow="FAQ" title="Before you get in touch" center id="faq-title" />
      <Faqs items={faqs} />
    </div>
  </section>
</SimplePage>
<style>
  .ctype-h { font-size: 20px; margin-bottom: 12px; }
  .ctype-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ctype-list a { display: grid; grid-template-columns: 24px 1fr; column-gap: 10px; align-items: center; padding: 12px 14px; background: var(--white); border: 1px solid var(--line-strong); border-radius: 6px; color: var(--ink); font-weight: 600; text-decoration: none; }
  .ctype-list a:hover { border-color: var(--green-text); }
  .ctype-list a :global(svg) { color: var(--green-text); }
  .ctype-list a span { grid-column: 2; font-weight: 400; font-size: 14px; color: var(--muted); }
  .cta-split { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 48px; align-items: start; }
  @media (max-width: 900px) { .cta-split { grid-template-columns: minmax(0, 1fr); } }
</style>
