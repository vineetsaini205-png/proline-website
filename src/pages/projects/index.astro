---
// Our work (strategy plan, 13 Nov 2026). Real job photos with only the facts we have: no customer names,
// no exact addresses, GPS stamps cropped or blurred (rule 11). Full case studies go at /projects/<slug>/
// once the owner confirms city, date, scope and the customer's permission for each job.
import SimplePage from '../../layouts/SimplePage.astro';
import SectionHead from '../../components/SectionHead.astro';
import Photo from '../../components/Photo.astro';
import site from '../../data/site.json';
import images from '../../data/images.json';

const meta = images as Record<string, { alt: string; caption?: string }>;
const cap = (k: string) => meta[k].caption ?? meta[k].alt;

const jobs = [
  {
    id: 'home-3-3-kw-maharashtra', kind: 'Home installation',
    title: '3.3 kW home charging point, Jambhulni, Maharashtra',
    facts: [['Where', 'Jambhulni, a village in Maharashtra'], ['When', '18 May 2026'], ['Charger', '3.3 kW socket in a DB box, used with the car’s own portable charger'], ['Proline scope', 'DB box and protection, earth pit and chamber, socket tests, first charge']],
    text: 'The house needed a dedicated charging point with an earth good enough for daily charging. Our team mounted the DB box with its socket and protection, dug an earth pit with a copper rod, finished it with a chamber, and tested the socket three times before the car charged from it the same evening. Every step was photographed, geotagged and time-stamped; the coordinates are hidden here.',
    photos: ['job-home-db-box', 'job-earth-pit', 'job-earth-chamber', 'job-socket-test'],
  },
  {
    id: 'basement-7-4-kw-network', kind: 'Commercial installation',
    title: '7.4 kW wallboxes as a multi-point network in a stack-parking basement',
    facts: [['Site', 'Basement car park with live stack-parking systems'], ['Chargers', 'Multiple 7.4 kW AC wallboxes (Bolt.Earth)'], ['Proline scope', 'Stands, shields, cable trays, signage, installation and testing']],
    text: 'Several charging points had to work in a busy basement, safe around parked cars and moving stack-parking platforms. Each wallbox sits on a steel pedestal stand anchored to the floor, behind an acrylic shield, with its cable in galvanised trays, and every point has an emergency stop and user QR signage. Each point was tested the same way as our home installations before handover.',
    photos: ['job-basement-row', 'job-basement-points', 'job-wallbox-stand', 'job-wallbox-closeup'],
  },
  {
    id: 'dc-charging-sites', kind: 'DC charging sites',
    title: 'DC fast-charging stations',
    facts: [['Client', 'Reliable Charge (station shown)'], ['Work shown', 'A canopy and power panel during installation, and a finished DC station']],
    text: 'For DC sites the work around the charger is most of the job: the foundation, the canopy, the power panel and the cable from it. The first photo shows a canopy going up with the power panel in place and the charger still in its wrapping; the second, a finished DC station for our client Reliable Charge.',
    photos: ['job-canopy-install', 'job-dc-station'],
  },
];
---
<SimplePage
  title="EV Charger Installation Projects | Proline"
  description="See documented Proline work, including site requirements, installation scope, photographs and handover details."
  h1="Our work"
  eyebrow="Real jobs, photographed by our team"
  crumb="Our work"
  lead="Photos and notes from Proline jobs: a home charging point, a basement network of wallboxes and DC charging sites. Captions say only what we know for certain; customer names and exact addresses are left out."
  cta={{ title: 'Discuss a similar job', lead: 'Tell us your vehicle or site, the city and what you need. We reply with what the job involves and our tie-up quote.' }}
  waText="Hello Proline, I saw your work on the website and would like to discuss a similar job.">
  <section class="section" aria-labelledby="clients-title">
    <div class="wrap">
      <SectionHead eyebrow="Who we have worked for" title="Installation work for networks, carmakers and homes" id="clients-title" />
      <p class="clients-line">We have done installation work for <strong>{site.clients.slice(0, -1).join(', ')} and {site.clients.at(-1)}</strong>, as well as for home owners, housing societies and businesses.</p>
      <dl class="work-stats">{site.stats.map((st) => <div><dt>{st.value}</dt><dd>{st.label}</dd></div>)}</dl>
    </div>
  </section>
  {jobs.map((j, i) => (
    <section class:list={['section', { 'section-soft': i % 2 === 0 }]} id={j.id} aria-labelledby={`${j.id}-title`}>
      <div class="wrap">
        <p class="eyebrow-plain">{j.kind}</p>
        <h2 id={`${j.id}-title`}>{j.title}</h2>
        <div class="job-top">
          <dl class="job-facts">{j.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          <p class="job-text">{j.text}</p>
        </div>
        <div class:list={['job-photos', `n${j.photos.length}`]}>
          {j.photos.map((p) => <figure><Photo name={p} sizes="(max-width: 760px) 100vw, 300px" /><figcaption>{cap(p)}</figcaption></figure>)}
        </div>
      </div>
    </section>
  ))}
</SimplePage>

<style>
  .clients-line { font-size: 17px; max-width: 820px; }
  .clients-line strong { color: var(--ink); }
  .work-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 28px; margin: 24px 0 0; }
  .work-stats div { border-left: 3px solid var(--green-text); padding-left: 14px; }
  .work-stats dt { font-weight: 700; font-size: 26px; color: var(--ink); line-height: 1.15; }
  .work-stats dd { margin: 2px 0 0; font-size: 14.5px; color: var(--muted); }
  .job-top { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 28px; margin-top: 18px; }
  .job-facts { margin: 0; display: grid; gap: 10px; align-content: start; }
  .job-facts div { display: grid; grid-template-columns: 130px 1fr; gap: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .job-facts dt { font-weight: 600; color: var(--ink); }
  .job-facts dd { margin: 0; }
  .job-text { font-size: 16.5px; }
  .job-photos { display: grid; gap: 14px; margin-top: 24px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .job-photos.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .job-photos figure { margin: 0; }
  .job-photos :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); background: var(--white); }
  .job-photos figcaption { margin-top: 6px; font-size: 14px; color: var(--muted); }
  @media (max-width: 900px) {
    .job-top { grid-template-columns: minmax(0, 1fr); }
    .job-photos, .job-photos.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .job-photos, .job-photos.n2 { grid-template-columns: minmax(0, 1fr); }
    .job-facts div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
