---
// Earnings calculator, rebuilt to the strategy plan (13 Nov 2026), section 4 "Fixing the earnings calculator":
// revenue, operating surplus and cash after finance are separate; costs not entered are named, never silently zero;
// low / base / high usage; payback from cumulative cash flow with a ramp-up; says so when it never pays back.
// No Proline or brand prices: costs come from public tariffs and rates, or from the visitor.
import ToolPage from '../../layouts/ToolPage.astro';
import Icon from '../../components/Icon.astro';
import tariffs from '../../data/tariffs.json';
import rates from '../../data/rates.json';
import { CHARGERS, station, rupees, type StationInput } from '../../lib/calc';
import { formatDate } from '../../lib/text';
import site from '../../data/site.json';

const def = { chargerId: 'dc-60', count: 1, state: 'Delhi' };
const c0 = CHARGERS.find((c) => c.id === def.chargerId)!;
const st0 = tariffs.states.find((s) => s.state === def.state)!;
const base: StationInput = {
  chargerId: def.chargerId, count: def.count, hoursPerDay: c0.hours.likely, pricePerKwh: rates.publicCharging.dc.default, priceIncludesGst: true,
  gstPct: rates.gstOnCharging, tariff: st0.tariff, fixedPerKw: st0.fixedPerKw, fixedFlat: (st0 as any).fixedFlat ?? 0, solarShare: null,
  auxKwh: null, rentMonthly: null, revenueSharePct: null, appCommissionPct: null, paymentFeePct: null, staffMonthly: null, maintenanceMonthly: null, cmsMonthly: null, otherMonthly: null,
  projectCost: null, workingCapital: null, loanAmount: null, loanRatePct: null, loanYears: null,
};
const sc = { low: c0.hours.quiet, base: c0.hours.likely, high: c0.hours.busy };
const r0 = station(base);
const rows0 = (['low', 'base', 'high'] as const).map((k) => ({ k, h: sc[k], r: station({ ...base, hoursPerDay: sc[k] }) }));
const cfg = { chargers: CHARGERS, states: tariffs.states, ac: rates.publicCharging.ac.default, dc: rates.publicCharging.dc.default, gst: rates.gstOnCharging, wa: site.whatsapp };
const checked = formatDate(new Date(tariffs.checked));
const label = { low: 'Low', base: 'Base', high: 'High' } as const;

const faqs = [
  { q: 'How much does an EV charging station earn in India?', a: 'It depends on how many hours a day the chargers are used, the price drivers pay per unit, your EV tariff and your site costs: rent or land share, staff, maintenance, payment fees and software. Enter your own numbers: the calculator shows revenue, operating surplus and cash after loan payments separately, for low, base and high usage.' },
  { q: 'How long does a new charging station take to get busy?', a: 'Usually 6–12 months, as drivers find the station on apps and maps ([Bolt.Earth](https://bolt.earth/franchise)). The payback here starts usage at 30% of the level you enter and builds it up over 12 months; change both under More settings.' },
  { q: 'Why does it say “before costs you have not entered”?', a: 'Because a cost left blank is not a cost of zero. Until you enter rent, staff, maintenance, payment fees, software and other site costs, the operating surplus leaves them out, and the calculator lists them so you can see what is missing.' },
  { q: 'Why does the calculator take GST out of the price?', a: 'Public charging is a service taxed at 18% GST, and the prices drivers see usually include it. The GST goes to the government, so your revenue is the price divided by 1.18.' },
  { q: 'What is the time-of-day rule?', a: 'The Ministry of Power’s 2024 guidelines set a single-part tariff for public charging, capped at the average cost of supply till 31 March 2028, with solar hours at 0.7 times and other hours at 1.3 times the tariff where time-of-day billing applies. Switch it on under More settings and set your share of solar-hour charging.' },
  { q: 'Why don’t you fill in the cost of the station?', a: 'Because it changes a lot with the chargers, the electricity connection, cabling and civil work at your site. Enter the project cost from your own estimate or quote and the calculator shows payback. For a quote for your site, [contact us](#quote).' },
  { q: 'Is this a promise of earnings?', a: 'No. It is an estimate from public tariffs and charging rates, your inputs and the assumptions shown on this page. Real earnings depend on your location, competition, uptime and pricing.' },
];
const field = (id: string, label: string, opts: { step?: string; hint?: string; value?: string | number; placeholder?: string; max?: string } = {}) => ({ id, label, ...opts });
const siteCostFields = [
  field('e-rent', 'Rent or land share (₹ a month)', { step: '500', placeholder: 'Not entered' }),
  field('e-share', 'Revenue share to landowner (%)', { step: '1', placeholder: 'None', max: '100' }),
  field('e-staff', 'Staff (₹ a month)', { step: '500', placeholder: 'Not entered' }),
  field('e-maint', 'Maintenance (₹ a month)', { step: '500', placeholder: 'Not entered', hint: 'Upkeep, AMC, repairs' }),
  field('e-fee', 'Payment fees (% of revenue)', { step: '0.1', placeholder: 'Not entered', max: '100', hint: 'Your payment gateway’s rate' }),
  field('e-app', 'App or aggregator commission (%)', { step: '1', placeholder: 'None', max: '100' }),
  field('e-cms', 'Charging software and hosting (₹ a month)', { step: '100', placeholder: 'Not entered' }),
  field('e-other', 'Other site costs (₹ a month)', { step: '500', placeholder: 'Not entered', hint: 'Internet, insurance, security, cleaning' }),
];
const projectFields = [
  field('e-cost', 'Project cost (₹)', { step: '1000', placeholder: 'From your estimate or quote', hint: 'Chargers, electricity connection, cabling, civil work, installation' }),
  field('e-wc', 'Working capital (₹)', { step: '1000', placeholder: 'Not entered', hint: 'Cash to run the first months' }),
  field('e-loan', 'Loan amount (₹)', { step: '1000', placeholder: 'No loan' }),
  field('e-rate', 'Interest rate (% a year)', { step: '0.1', placeholder: '–', max: '40' }),
  field('e-years', 'Loan term (years)', { step: '1', placeholder: '–', max: '20' }),
];
const fmtPay = (r: ReturnType<typeof station>) => r.paybackMonths ? `${r.paybackMonths} months` : r.neverPaysBack ? 'Not within 10 years' : 'Enter project cost';
---
<ToolPage
  title="EV Charging Station Earnings Calculator | Proline"
  description="Estimate revenue, operating costs and payback using visible assumptions for your proposed charging site, with low, base and high usage."
  h1="EV charging station earnings calculator"
  label="Earnings calculator"
  intro="Estimate what a charging station could bring in, from your charger, your state’s EV tariff, the price drivers pay and your own site costs. Revenue, operating surplus and cash after loan payments are shown separately, for low, base and high usage. Add your project cost to see payback, counted month by month as usage builds up."
  faqs={faqs}
  related={['/start-an-ev-charging-station/', '/blog/ev-charging-station-earnings/', '/chargers/dc-fast-chargers/', '/for/businesses/']}
  form="station" need="DC fast charger or charging station"
  ctaTitle="Discuss these assumptions"
  ctaLead="Share your location, the chargers you have in mind and your sanctioned load. We go through the numbers with you and reply with our tie-up quote, so you can put real costs into the calculator."
  waText="Hello Proline, I want to discuss a commercial charging site.">

  <div class="calc" id="earn" data-cfg={JSON.stringify(cfg)}>
    <form class="calc-in" onsubmit="return false" aria-label="Your station">
      <div class="calc-sticky" aria-hidden="true"><span>Operating surplus (base)</span><strong id="o-sticky">{rupees(r0.surplus)}</strong><a href="#o-head">Details ↓</a></div>
      <div class="field">
        <label for="e-charger">Charger</label>
        <select id="e-charger">{CHARGERS.map((c) => <option value={c.id} selected={c.id === def.chargerId}>{c.label}</option>)}</select>
      </div>
      <div class="grid grid-2" style="gap:14px">
        <div class="field"><label for="e-count">Number of chargers</label><input id="e-count" type="number" min="1" max="100" step="1" value="1" inputmode="numeric" /></div>
        <div class="field">
          <label for="e-state">State</label>
          <select id="e-state">
            {tariffs.states.map((s) => <option value={s.state} selected={s.state === def.state}>{s.state}</option>)}
            <option value="other">Other: type your tariff</option>
          </select>
        </div>
      </div>
      <fieldset class="field hours-set">
        <legend class="label">Charging hours a day per charger, once usage has built up</legend>
        <div class="grid grid-3" style="gap:10px">
          <div class="field"><label for="e-h-low">Low</label><input id="e-h-low" type="number" min="0" max="24" step="0.5" value={sc.low} inputmode="decimal" /></div>
          <div class="field"><label for="e-h-base">Base</label><input id="e-h-base" type="number" min="0" max="24" step="0.5" value={sc.base} inputmode="decimal" /></div>
          <div class="field"><label for="e-h-high">High</label><input id="e-h-high" type="number" min="0" max="24" step="0.5" value={sc.high} inputmode="decimal" /></div>
        </div>
        <p class="hint">Filled in with Proline’s starting assumption for this charger. Replace with your own.</p>
      </fieldset>
      <div class="grid grid-2" style="gap:14px">
        <div class="field">
          <label for="e-price">Price drivers pay (₹ a unit)</label>
          <input id="e-price" type="number" min="0" max="60" step="0.5" value={rates.publicCharging.dc.default} inputmode="decimal" />
          <p class="hint" id="e-price-hint">Public DC charging: ₹{rates.publicCharging.dc.min}–{rates.publicCharging.dc.max} a unit</p>
        </div>
        <div class="field">
          <label for="e-tariff">Your EV tariff (₹ a unit)</label>
          <input id="e-tariff" type="number" min="0" max="20" step="0.01" value={st0.tariff} inputmode="decimal" />
          <p class="hint" id="e-tariff-note">{(st0 as any).note ?? 'LT tariff for public charging'} · {tariffs.source}, checked {checked}</p>
        </div>
      </div>
      <details class="adv" open>
        <summary>Site costs a month<Icon name="chevronDown" size={18} class="chev" /></summary>
        <div class="adv-body"><div class="grid grid-2" style="gap:14px">
          {siteCostFields.map((f) => <div class="field"><label for={f.id}>{f.label}</label><input id={f.id} type="number" min="0" max={f.max} step={f.step} placeholder={f.placeholder} inputmode="decimal" />{f.hint && <p class="hint">{f.hint}</p>}</div>)}
        </div></div>
      </details>
      <details class="adv">
        <summary>Project cost and loan<Icon name="chevronDown" size={18} class="chev" /></summary>
        <div class="adv-body"><div class="grid grid-2" style="gap:14px">
          {projectFields.map((f) => <div class="field"><label for={f.id}>{f.label}</label><input id={f.id} type="number" min="0" max={f.max} step={f.step} placeholder={f.placeholder} inputmode="decimal" />{f.hint && <p class="hint">{f.hint}</p>}</div>)}
        </div><p class="hint">We never fill in the project cost for you.</p></div>
      </details>
      <details class="adv">
        <summary>More settings: availability, auxiliary power, fixed charges, GST, ramp-up<Icon name="chevronDown" size={18} class="chev" /></summary>
        <div class="adv-body">
          <div class="grid grid-2" style="gap:14px">
            <div class="field"><label for="e-days">Operating days a month</label><input id="e-days" type="number" min="1" max="31" step="1" value="30" inputmode="numeric" /></div>
            <div class="field"><label for="e-avail">Charger availability (%)</label><input id="e-avail" type="number" min="0" max="100" step="1" value="95" inputmode="numeric" /><p class="hint">Share of time the charger works</p></div>
            <div class="field"><label for="e-aux">Auxiliary electricity (kWh a month)</label><input id="e-aux" type="number" min="0" step="10" placeholder="Not entered" inputmode="numeric" /><p class="hint">Lights, cooling, standby power</p></div>
            <div class="field"><label for="e-fixed">Fixed or demand charge (₹ per kW a month)</label><input id="e-fixed" type="number" min="0" step="1" value={st0.fixedPerKw} inputmode="decimal" /></div>
            <div class="field"><label for="e-ramp">Usage in the first month (% of built-up level)</label><input id="e-ramp" type="number" min="0" max="100" step="5" value="30" inputmode="numeric" /></div>
            <div class="field"><label for="e-rampm">Months for usage to build up</label><input id="e-rampm" type="number" min="0" max="36" step="1" value="12" inputmode="numeric" /></div>
          </div>
          <label style="display:flex;gap:10px;align-items:center;font-weight:500;min-height:44px"><input id="e-gst" type="checkbox" checked style="width:20px;height:20px;accent-color:#0B7D4A" />Price drivers pay includes 18% GST</label>
          <label style="display:flex;gap:10px;align-items:center"><input id="e-tod" type="checkbox" style="width:20px;height:20px;accent-color:#0B7D4A" />Apply the time-of-day rule (solar hours 0.7×, other hours 1.3×)</label>
          <div class="field range-field">
            <div class="rf-top"><label for="e-solar">Share of charging in solar hours</label><output id="e-solar-out" for="e-solar">40%</output></div>
            <input id="e-solar" type="range" min="0" max="100" step="5" value="40" disabled />
          </div>
        </div>
      </details>
    </form>

    <div class="calc-out" aria-live="polite">
      <div id="o-head">
        <p class="small">Base usage, a month once it has built up</p>
        <dl class="o-three">
          <div><dt>Revenue after GST</dt><dd id="o-rev3">{rupees(r0.revenue)}</dd></div>
          <div><dt>Operating surplus</dt><dd id="o-sur3">{rupees(r0.surplus)}</dd></div>
          <div><dt>Cash after loan payment</dt><dd id="o-cash3">{rupees(r0.cashAfterFinance)}</dd></div>
        </dl>
      </div>
      <p class="o-missing" id="o-missing">{r0.missing.length ? `Before costs you have not entered: ${r0.missing.join(', ')}.` : ''}</p>
      <dl class="calc-rows">
        <div><dt>Units sold a month</dt><dd id="o-units">{Math.round(r0.kwhSold).toLocaleString('en-IN')} kWh</dd></div>
        <div><dt>Revenue after GST</dt><dd id="o-rev">{rupees(r0.revenue)}</dd></div>
        <div><dt>Electricity bought (with losses and auxiliary use)</dt><dd id="o-elec">−{rupees(r0.electricity)}</dd></div>
        <div><dt>Fixed or demand charges</dt><dd id="o-fixed">−{rupees(r0.fixed)}</dd></div>
        <div><dt>Site costs</dt><dd id="o-site">−{rupees(r0.siteCosts)}</dd></div>
        <div><dt>Operating surplus</dt><dd id="o-sur">{rupees(r0.surplus)}</dd></div>
        <div><dt>Loan payment</dt><dd id="o-emi">−{rupees(r0.emi)}</dd></div>
        <div><dt>Cash after loan payment</dt><dd id="o-cash">{rupees(r0.cashAfterFinance)}</dd></div>
      </dl>
      <div class="table-wrap o-scen">
        <table>
          <thead><tr><th scope="col">Usage</th><th scope="col">Revenue</th><th scope="col">Surplus</th><th scope="col">Cash after loan</th><th scope="col">Payback</th></tr></thead>
          <tbody id="o-scen">{rows0.map(({ k, h, r }) => <tr><th scope="row">{label[k]} ({h} h)</th><td>{rupees(r.revenue)}</td><td>{rupees(r.surplus)}</td><td>{rupees(r.cashAfterFinance)}</td><td>{fmtPay(r)}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" id="o-wa" href="#" rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />Discuss these assumptions</a>
        <a class="btn btn-ghost-light" id="o-quote" href="#quote">Send them with a form</a>
      </div>
      <p class="calc-note">Estimate only, not a promise of earnings. Payback counts your project cost and working capital, less any loan, against each month’s cash, with usage building up as set under More settings.</p>
    </div>
  </div>

  <div slot="method">
    <h2 id="method-title">How the calculator works</h2>
    <p>It follows the money for one month, then month by month for payback. Every number it uses is on this page, so you can check it or change it.</p>
    <ol>
      <li><strong>Units sold</strong> = average power while a vehicle charges × charging hours a day × operating days × charger availability × number of chargers.</li>
      <li><strong>Revenue</strong> = units × the price drivers pay, divided by 1.18 when that price includes 18% GST.</li>
      <li><strong>Electricity bought</strong> = (units ÷ the charger’s efficiency + auxiliary kWh) × your EV tariff (× the time-of-day factor if you switch it on).</li>
      <li><strong>Operating surplus</strong> = revenue − electricity − fixed or demand charges − site costs (rent, revenue share, payment fees, app commission, staff, maintenance, software, other).</li>
      <li><strong>Cash after loan payment</strong> = operating surplus − the monthly loan instalment while the loan runs.</li>
      <li><strong>Payback</strong> = the first month when the running total of cash covers your project cost and working capital, less the loan. Usage starts at the share you set and builds up to the level you entered. If that never happens within 10 years, the calculator says so.</li>
    </ol>
    <h3>Whose assumptions these are</h3>
    <p>The low, base and high hours, the average power, the charger efficiency, 95% availability and the 30%, 12-month ramp-up are Proline’s starting assumptions for a new public site; replace them with your own. Tariffs are the LT rates for public charging stations from the <a href={tariffs.sourceUrl} rel="noopener" target="_blank">{tariffs.source}</a>, checked on {checked}; use the rate on your own bill or tariff order if it differs. Public charging prices are typical ranges: AC ₹{rates.publicCharging.ac.min}–{rates.publicCharging.ac.max} and DC ₹{rates.publicCharging.dc.min}–{rates.publicCharging.dc.max} a unit.</p>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">Charger</th><th scope="col">Average power</th><th scope="col">Efficiency</th><th scope="col">Low / base / high</th></tr></thead>
        <tbody>{CHARGERS.map((c) => <tr><td>{c.label}</td><td>{c.avgKw} kW</td><td>{Math.round(c.efficiency * 100)}%</td><td>{c.hours.quiet} / {c.hours.likely} / {c.hours.busy} h a day</td></tr>)}</tbody>
      </table>
    </div>
    <h3>What it leaves out</h3>
    <p>Depreciation, income tax, price and tariff changes over time, and charger replacement. Usage at a new station typically builds over 6–12 months (<a href="https://bolt.earth/franchise" rel="noopener" target="_blank">Bolt.Earth</a>). For the full picture, read <a href="/start-an-ev-charging-station/">how to plan a charging station</a>.</p>
  </div>
</ToolPage>

<style>
  .hours-set { border: 0; padding: 0; margin: 0; }
  .hours-set .field label { font-size: 14px; }
  .o-three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 8px 0 0; }
  .o-three div { border-left: 3px solid var(--green); padding-left: 10px; }
  .o-three dt { font-size: 13px; color: #A9BBD3; }
  .o-three dd { margin: 2px 0 0; font-size: clamp(20px, 2.2vw, 26px); font-weight: 700; color: var(--white); font-variant-numeric: tabular-nums; }
  .o-missing { margin: 0; padding: 10px 12px; border-radius: 6px; background: rgba(255, 196, 87, .12); border: 1px solid rgba(255, 196, 87, .35); color: #FFE2A8; font-size: 14px; }
  .o-missing:empty { display: none; }
  .o-scen table { width: 100%; font-size: 14px; color: #C9D6E8; }
  .o-scen th, .o-scen td { padding: 8px 6px; border-bottom: 1px solid rgba(255,255,255,.12); text-align: right; font-variant-numeric: tabular-nums; }
  .o-scen th:first-child, .o-scen thead th:first-child { text-align: left; }
  .o-scen thead th { color: #A9BBD3; font-weight: 600; }
  .o-scen tbody th { color: var(--white); font-weight: 600; }
  @media (max-width: 560px) { .o-three { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { station, rupees, type ChargerPreset, type StationInput } from '../../lib/calc';
  const root = document.getElementById('earn');
  if (root) {
    const cfg = JSON.parse(root.dataset.cfg || '{}') as { chargers: ChargerPreset[]; states: { state: string; tariff: number; fixedPerKw: number; fixedFlat?: number; note?: string }[]; ac: number; dc: number; gst: number; wa: string };
    const el = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
    const num = (id: string) => Number(el(id).value) || 0;
    const opt = (id: string): number | null => { const v = el(id).value.trim(); return v === '' ? null : Number(v) || 0; };
    const charger = () => cfg.chargers.find((c) => c.id === el<HTMLSelectElement>('e-charger').value)!;
    let fixedFlat = 0;
    const onCharger = () => {
      const c = charger();
      el('e-h-low').value = String(c.hours.quiet); el('e-h-base').value = String(c.hours.likely); el('e-h-high').value = String(c.hours.busy);
      el('e-price').value = String(c.kind === 'dc' ? cfg.dc : cfg.ac);
      el('e-price-hint').textContent = c.kind === 'dc' ? 'Public DC charging: ₹15–25 a unit' : 'Public AC charging: ₹8–15 a unit';
    };
    const onState = () => {
      const s = cfg.states.find((x) => x.state === el<HTMLSelectElement>('e-state').value);
      if (s) { el('e-tariff').value = String(s.tariff); el('e-fixed').value = String(s.fixedPerKw); fixedFlat = s.fixedFlat ?? 0; }
      else { el('e-tariff').focus(); fixedFlat = 0; el('e-tariff-note').textContent = 'Type the EV tariff from your DISCOM’s tariff order'; }
    };
    const pay = (r: ReturnType<typeof station>) => r.paybackMonths ? `${r.paybackMonths} months` : r.neverPaysBack ? 'Not within 10 years' : 'Enter project cost';
    const calc = () => {
      const c = charger();
      const tod = el('e-tod'); const solar = el('e-solar');
      solar.disabled = !tod.checked; el('e-solar-out').textContent = `${solar.value}%`;
      const base: StationInput = {
        chargerId: c.id, count: Math.max(1, Math.round(num('e-count'))), hoursPerDay: num('e-h-base'), days: num('e-days') || 30, availability: Math.min(100, num('e-avail')) / 100,
        pricePerKwh: num('e-price'), priceIncludesGst: el('e-gst').checked, gstPct: cfg.gst, tariff: num('e-tariff'), fixedPerKw: num('e-fixed'), fixedFlat,
        solarShare: tod.checked ? Number(solar.value) / 100 : null, auxKwh: opt('e-aux'),
        rentMonthly: opt('e-rent'), revenueSharePct: opt('e-share'), appCommissionPct: opt('e-app'), paymentFeePct: opt('e-fee'), staffMonthly: opt('e-staff'),
        maintenanceMonthly: opt('e-maint'), cmsMonthly: opt('e-cms'), otherMonthly: opt('e-other'),
        projectCost: opt('e-cost'), workingCapital: opt('e-wc'), loanAmount: opt('e-loan'), loanRatePct: opt('e-rate'), loanYears: opt('e-years'),
        rampStartPct: num('e-ramp'), rampMonths: num('e-rampm'),
      };
      const r = station(base);
      el('o-rev3').textContent = rupees(r.revenue); el('o-sur3').textContent = rupees(r.surplus); el('o-cash3').textContent = rupees(r.cashAfterFinance);
      el('o-sticky').textContent = rupees(r.surplus);
      el('o-missing').textContent = r.missing.length ? `Before costs you have not entered: ${r.missing.join(', ')}.` : '';
      el('o-units').textContent = `${Math.round(r.kwhSold).toLocaleString('en-IN')} kWh`;
      el('o-rev').textContent = rupees(r.revenue); el('o-elec').textContent = `−${rupees(r.electricity)}`; el('o-fixed').textContent = `−${rupees(r.fixed)}`;
      el('o-site').textContent = `−${rupees(r.siteCosts)}`; el('o-sur').textContent = rupees(r.surplus); el('o-emi').textContent = `−${rupees(r.emi)}`; el('o-cash').textContent = rupees(r.cashAfterFinance);
      const scen = ([['Low', 'e-h-low'], ['Base', 'e-h-base'], ['High', 'e-h-high']] as const).map(([l, id]) => ({ l, h: num(id), r: station({ ...base, hoursPerDay: num(id) }) }));
      el('o-scen').innerHTML = scen.map((s) => `<tr><th scope="row">${s.l} (${s.h} h)</th><td>${rupees(s.r.revenue)}</td><td>${rupees(s.r.surplus)}</td><td>${rupees(s.r.cashAfterFinance)}</td><td>${pay(s.r)}</td></tr>`).join('');
      const st = el<HTMLSelectElement>('e-state').value;
      const summary = `Earnings calculator: ${base.count} × ${c.label}, ${st === 'other' ? 'state not listed' : st}, ${scen.map((s) => `${s.l.toLowerCase()} ${s.h} h/day`).join(', ')}, ₹${base.pricePerKwh}/unit, tariff ₹${base.tariff}/unit → base: revenue ${rupees(r.revenue)}, operating surplus ${rupees(r.surplus)}, cash after loan ${rupees(r.cashAfterFinance)} a month; payback ${pay(r)}${r.missing.length ? `; not entered: ${r.missing.join(', ')}` : ''}.`;
      el<HTMLAnchorElement>('o-wa').href = `https://wa.me/${cfg.wa}?text=${encodeURIComponent('Hello Proline, I want to discuss a commercial charging site. ' + summary)}`;
      (window as any).prolineFill?.('#quote-form', summary);
      root.dataset.summary = summary;
    };
    root.addEventListener('change', (e) => {
      const t = e.target as HTMLElement;
      if (t.id === 'e-charger') onCharger();
      if (t.id === 'e-state') onState();
      calc();
    });
    root.addEventListener('input', calc);
    el('o-quote').addEventListener('click', () => (window as any).prolineFill?.('#quote-form', root.dataset.summary || ''));
    calc();
  }
</script>
