---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const links = [
  ['EV charger installation', '/services/ev-charger-installation/'], ['Home charger installation', '/services/home-ev-charger-installation/'],
  ['Earnings calculator', '/tools/ev-charging-station-earnings-calculator/'], ['EV vs petrol savings', '/tools/ev-vs-petrol-savings-calculator/'],
  ['Proline CMS', '/cms/'], ['Contact', '/contact/'],
];
---
<Base headerCta={{ label: 'Get a quote', href: '/contact/#quote' }} title="Page not found | Proline Electrical Works" description="This page doesn’t exist. Find EV charger installation, tools and contact details on the Proline Electrical Works website." noindex>
  <section class="section">
    <div class="wrap-narrow center">
      <p class="eyebrow">Error 404</p>
      <h1>This page isn’t here</h1>
      <p class="lead" style="margin-top:16px;font-size:18px">The link may be old or mistyped. These pages are a good place to start:</p>
      <div class="grid grid-2" style="margin-top:28px;text-align:left">
        {links.map(([l, h]) => <a class="card" href={h} style="flex-direction:row;align-items:center;justify-content:space-between;padding:18px 20px"><strong style="color:var(--ink)">{l}</strong><Icon name="arrowRight" size={18} /></a>)}
      </div>
      <p style="margin-top:28px"><a class="btn btn-primary" href="/">Go to the homepage</a></p>
    </div>
  </section>
</Base>
