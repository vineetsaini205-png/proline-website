---
// Home page. Kept short on purpose (owner, 24 Oct: "too much information on one page"; 25 Oct: one idea
// per screen on phones, like Tata Power and Statiq): photo hero with the numbers, six services as photo
// cards (a swipe row on phones), Proline CMS, calculators in one card, five FAQs, contact form.
// Everything else has its own page, linked from the menu and the footer.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import Faqs from '../components/Faqs.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';
import { waLink } from '../lib/text';
import screens from '../data/cms-screens.json';
import { faqNode } from '../lib/schema';

const title = 'Proline Electrical Works | EV Charger Installation in India';
const description = 'Proline installs and commissions EV chargers of any brand across India: AC and DC chargers, earthing, cabling and civil work. Free advice on choosing a charger.';

const services = [
  { photo: 'ac-pedestal-charger', title: 'EV charger installation', text: 'AC and DC chargers of any brand, installed and tested.', href: '/services/ev-charger-installation/' },
  { photo: 'ac-charger-plug', title: 'Home charger installation', text: 'Wall-box chargers fitted safely at home.', href: '/services/home-ev-charger-installation/' },
  { photo: 'dc-hub-bays', title: 'Charging stations', text: 'DC fast chargers and turnkey stations, survey to go-live.', href: '/services/ev-charging-station-setup/' },
  { photo: 'solar-canopy-aerial', title: 'Site survey', text: 'Know what your site needs before you buy.', href: '/services/site-survey/' },
  { photo: 'dc-cabinet-charging', title: 'AMC and maintenance', text: 'Planned visits, safety tests and a report each time.', href: '/services/ev-charger-amc/' },
  { photo: 'solar-canopy-tall', title: 'Earthing, cabling, civil', text: 'Tested earth pits, sized cable, foundations, canopies.', href: '/services/ev-charger-earthing/' },
];

const tools = [
  { title: 'Charging station earnings', text: 'Monthly profit for your state, charger and prices, from quiet to busy.', href: '/tools/ev-charging-station-earnings-calculator/' },
  { title: 'EV vs petrol savings', text: 'What you save each month by driving electric, and the CO₂ avoided.', href: '/tools/ev-vs-petrol-savings-calculator/' },
  { title: 'Charger finder', text: 'Which charger fits your need.', href: '/tools/charger-finder/' },
  { title: 'Installation checklist', text: 'What your installation needs.', href: '/tools/installation-checklist/' },
];

const faqs = [
  { q: 'Do you install EV chargers of any brand?', a: 'Yes. Proline is brand-neutral: we survey, install and commission AC and DC chargers from any maker, and the free consultation helps you choose the right one for your site. We have installed chargers for TATA, ThunderPlus, Bolt.Earth and KIA.' },
  { q: 'Which states do you work in?', a: `We are based in Delhi and work across ${site.regions.flatMap((r) => r.states).join(', ')}. See the [coverage page](/coverage/).` },
  { q: 'How much does EV charger installation cost?', a: 'It depends on the charger, the cable run from your meter or panel, the earthing and DB box, any civil work, and whether your connection needs more load. We don’t publish prices because no two sites are the same; send us a few details or photos and we reply with one clear quote.' },
  { q: 'Is the site survey free?', a: 'The site survey is paid. If you go ahead with Proline, the survey fee is adjusted against your order. For a simple home installation, photos on WhatsApp are often enough to quote.' },
  { q: 'What is Proline CMS?', a: 'Our own charge management software for charge point operators: chargers of any brand on one console, QR and UPI payments with automatic refunds, GST documents, in your brand and on your own server. [See Proline CMS](/cms/).' },
];
const desk = screens.desktop[0];
---
<Base title={title} description={description} schema={[faqNode('/', faqs)]}>
  <section class="hero hero-dark">
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">Pan-India EV charging partner</p>
        <h1>EV charger installation and commissioning <span class="underline-green">across India</span></h1>
        <p class="lead">Chargers of any brand, installed, tested and handed over by one team. Free consultation: we help you pick the right charger.</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="#quote">Get a quote</a>
          <a class="btn btn-ghost-light btn-lg" href={waLink(site.whatsapp)} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />WhatsApp us</a>
        </div>
        <dl class="hero-stats" aria-label="Proline in numbers">
          {site.stats.map((st) => <div><dt>{st.value}</dt><dd>{st.label}</dd></div>)}
        </dl>
        <p class="hero-clients">Installed for <b>{site.clients.join(' · ')}</b></p>
      </div>
      <div class="hero-media">
        <Photo name="dc-hub-canopy" eager sizes="(max-width: 900px) 100vw, 560px" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <div class="shead-row">
        <SectionHead eyebrow="Services" title="Everything from site survey to handover" lead="For charge point operators, charger brands, businesses and homes." id="services-title" />
        <a class="link-arrow" href="/services/">All services<Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="grid grid-3 swipe">
        {services.map((sv) => (
          <a class="pcard" href={sv.href}>
            <Photo name={sv.photo} alt="" sizes="(max-width: 760px) 82vw, 380px" />
            <span class="pc-body"><strong>{sv.title}<Icon name="arrowRight" size={18} /></strong><span>{sv.text}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-navy" id="cms" aria-labelledby="cms-title">
    <div class="wrap split">
      <div>
        <h2 id="cms-title">Proline CMS: your own charging software, in your brand</h2>
        <p class="lead" style="margin-top:14px">Run every charger you own, whatever the brand. Drivers scan a QR code and pay by UPI, and unused money goes back to them automatically. No commission and no per-charger fees.</p>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn btn-primary" href="/cms/">See Proline CMS<Icon name="arrowRight" size={18} /></a>
        </div>
      </div>
      <figure style="margin:0">
        <div class="laptop"><div class="screen"><img src={desk.image} width="1600" height="1000" alt={`Proline CMS ${desk.title.toLowerCase()}: ${desk.caption}`} loading="lazy" decoding="async" /></div></div>
        {desk.concept && <figcaption class="frame-caption" style="color:#A9BBD3;margin-top:24px"><span class="concept-tag">Concept design · sample data</span></figcaption>}
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="wrap">
      <SectionHead eyebrow="Free calculators" title="See the numbers before you call us" id="tools-title" />
      <div class="tool-list">
        {tools.map((t) => (
          <a href={t.href}><span><strong>{t.title}</strong><span>{t.text}</span></span><Icon name="arrowRight" size={18} /></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="faq-title">
    <div class="wrap-narrow">
      <SectionHead eyebrow="FAQ" title="Questions we are often asked" center id="faq-title" />
      <Faqs items={faqs} />
      <p class="center" style="margin-top:20px"><a class="link-arrow" href="/faq/">More answers<Icon name="arrowRight" size={16} /></a></p>
    </div>
  </section>

  <CtaBand />
</Base>
