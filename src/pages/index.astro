---
// Home page. Kept short on purpose (owner, 24 Oct: "too much information on one page"):
// hero + numbers, six services, Proline CMS, two calculators, five FAQs, contact form.
// Everything else has its own page, linked from the menu and the footer.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import Faqs from '../components/Faqs.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';
import screens from '../data/cms-screens.json';
import { faqNode } from '../lib/schema';

const title = 'Proline Electrical Works | EV Charger Installation in India';
const description = 'Proline installs and commissions EV chargers of any brand across India: AC and DC chargers, earthing, cabling and civil work. Free advice on choosing a charger.';

const services = [
  { icon: 'plug', title: 'EV charger installation', text: 'AC and DC chargers of any brand, installed and tested.', href: '/services/ev-charger-installation/' },
  { icon: 'home', title: 'Home charger installation', text: 'Wall-box chargers fitted safely at home.', href: '/services/home-ev-charger-installation/' },
  { icon: 'station', title: 'Charging stations', text: 'DC fast chargers and turnkey stations, survey to go-live.', href: '/services/ev-charging-station-setup/' },
  { icon: 'clipboard', title: 'Site survey', text: 'Know what your site needs before you buy.', href: '/services/site-survey/' },
  { icon: 'wrench', title: 'AMC and maintenance', text: 'Planned visits, safety tests and a report each time.', href: '/services/ev-charger-amc/' },
  { icon: 'earth', title: 'Earthing, cabling, civil', text: 'Tested earth pits, sized cable, foundations, canopies.', href: '/services/ev-charger-earthing/' },
];

const tools = [
  { icon: 'trending', title: 'Charging station earnings', text: 'Monthly profit for your state, charger and prices, from quiet to busy.', href: '/tools/ev-charging-station-earnings-calculator/' },
  { icon: 'fuel', title: 'EV vs petrol savings', text: 'What you save each month by driving electric, and the CO₂ avoided.', href: '/tools/ev-vs-petrol-savings-calculator/' },
];

const faqs = [
  { q: 'Do you install EV chargers of any brand?', a: 'Yes. Proline is brand-neutral: we survey, install and commission AC and DC chargers from any maker, and the free consultation helps you choose the right one for your site. We have installed chargers for TATA, ThunderPlus, Bolt.Earth and KIA.' },
  { q: 'Which states do you work in?', a: `We are based in Delhi and work across ${site.regions.flatMap((r) => r.states).join(', ')}. See the [coverage page](/coverage/).` },
  { q: 'How much does EV charger installation cost?', a: 'It depends on the charger, the cable run from your meter or panel, the earthing and DB box, any civil work, and whether your connection needs more load. We don’t publish prices because no two sites are the same; send us a few details or photos and we reply with one clear quote.' },
  { q: 'Is the site survey free?', a: 'The site survey is paid. If you go ahead with Proline, the survey fee is adjusted against your order. For a simple home installation, photos on WhatsApp are often enough to quote.' },
  { q: 'What is Proline CMS?', a: 'Our own charge management software for charge point operators: chargers of any brand on one console, QR and UPI payments with automatic refunds, GST documents, in your brand and on your own server. [See Proline CMS](/cms/).' },
];
const desk = screens.desktop[0];
---
<Base title={title} description={description} schema={[faqNode('/', faqs)]}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">Pan-India EV charging partner</p>
        <h1>EV charger installation and commissioning <span class="underline-green">across India</span></h1>
        <p class="lead">Chargers of any brand, installed, tested and handed over by one team, for operators, brands, businesses and homes.</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="#quote">Get a quote</a>
          <a class="btn btn-outline btn-lg" href="/services/">Our services<Icon name="arrowRight" size={18} /></a>
        </div>
        <ul class="checks">
          <li><Icon name="check" size={18} stroke={2.5} />Any charger brand</li>
          <li><Icon name="check" size={18} stroke={2.5} />Survey to handover</li>
          <li><Icon name="check" size={18} stroke={2.5} />AMC available</li>
        </ul>
      </div>
      <div class="hero-media">
        <Photo name="dc-hub-canopy" eager sizes="(max-width: 900px) 100vw, 560px" />
      </div>
    </div>
  </section>

  <TrustStrip />

  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <div class="shead-row">
        <SectionHead eyebrow="Services" title="Everything from site survey to handover" id="services-title" />
        <a class="link-arrow" href="/services/">All services<Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="grid grid-3 tiles">
        {services.map((s) => (
          <a class="tile" href={s.href}>
            <span class="card-icon"><Icon name={s.icon} size={22} /></span>
            <span><strong>{s.title}</strong><span>{s.text}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-navy" id="cms" aria-labelledby="cms-title">
    <div class="wrap split">
      <div>
        <p class="eyebrow-plain">Proline CMS</p>
        <h2 id="cms-title">Your own charging software, in your brand</h2>
        <p class="lead" style="margin-top:14px">Run every charger you own, whatever the brand. Drivers scan a QR code and pay by UPI, and unused money goes back to them automatically.</p>
        <ul class="ticks" style="margin-top:20px">
          <li>Any charger brand, one console</li>
          <li>On your server, or hosted by us in India with 24/7 support</li>
          <li>No commission and no per-charger fees</li>
        </ul>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn btn-primary" href="/cms/demo/">Book a demo</a>
          <a class="btn btn-ghost-light" href="/cms/">See how it works<Icon name="arrowRight" size={18} /></a>
        </div>
      </div>
      <figure style="margin:0">
        <div class="laptop"><div class="screen"><img src={desk.image} width="1600" height="1000" alt={`Proline CMS ${desk.title.toLowerCase()}: ${desk.caption}`} loading="lazy" decoding="async" /></div></div>
        {desk.concept && <figcaption class="frame-caption" style="color:#A9BBD3;margin-top:24px"><span class="concept-tag">Concept design · sample data</span></figcaption>}
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="wrap">
      <SectionHead eyebrow="Free calculators" title="See the numbers before you call us" id="tools-title" />
      <div class="grid grid-2">
        {tools.map((t) => (
          <a class="card" href={t.href}>
            <span class="card-icon navy"><Icon name={t.icon} size={22} /></span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <span class="card-cta">Open the calculator<Icon name="arrowRight" size={16} /></span>
          </a>
        ))}
      </div>
      <p class="small muted" style="margin-top:16px">Also: <a href="/tools/charger-finder/">charger finder</a> · <a href="/tools/installation-checklist/">installation checklist</a> · <a href="/blog/">guides</a></p>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="faq-title">
    <div class="wrap-narrow">
      <SectionHead eyebrow="FAQ" title="Questions we are often asked" center id="faq-title" />
      <Faqs items={faqs} />
      <p class="center" style="margin-top:20px"><a class="link-arrow" href="/faq/">More answers<Icon name="arrowRight" size={16} /></a></p>
    </div>
  </section>

  <CtaBand />
</Base>
