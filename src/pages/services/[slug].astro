---
import { getCollection } from 'astro:content';
import LandingPage from '../../layouts/LandingPage.astro';
export async function getStaticPaths() {
  const entries = await getCollection('services', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<LandingPage entry={entry} crumbs={entry.id === 'ev-charger-installation' ? [{ label: entry.data.label }] : [{ label: 'Installation', href: '/services/ev-charger-installation/' }, { label: entry.data.label }]} />
