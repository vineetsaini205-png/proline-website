---
// One page per car model: which home charger suits it and how we install it (content in src/content/cars).
import { getCollection } from 'astro:content';
import LandingPage from '../../../layouts/LandingPage.astro';
export async function getStaticPaths() {
  const entries = await getCollection('cars', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<LandingPage entry={entry} crumbs={[{ label: 'Chargers', href: '/chargers/' }, { label: 'For your car', href: '/chargers/for/' }, { label: entry.data.label }]} />
