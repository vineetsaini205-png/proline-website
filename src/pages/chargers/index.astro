---
import { getCollection } from 'astro:content';
import HubPage from '../../layouts/HubPage.astro';
import SectionHead from '../../components/SectionHead.astro';
import ChargerTypes from '../../components/ChargerTypes.astro';
import ChargerSizes from '../../components/ChargerSizes.astro';
import ChargerFinder from '../../components/ChargerFinder.astro';
import Icon from '../../components/Icon.astro';
import { cars } from '../../data/nav';
const chargers = (await getCollection('chargers', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ icon: e.data.icon, label: e.data.label, summary: e.data.summary, href: `/chargers/${e.id}/` }));
const items = [
  ...chargers,
  { icon: 'battery', label: 'Batteries', summary: 'Lithium batteries for e-scooters and e-rickshaws, inverter and solar batteries, and BESS for stations.', href: '/batteries/' },
  { icon: 'sun', label: 'Solar + EV charging', summary: 'Solar carports and rooftops that power your chargers, with storage where it pays off.', href: '/solar-ev-charging/' },
];
const faqs = [
  { q: 'Do you sell chargers of one brand only?', a: 'No. We are tied up with several charger makers and suggest the one that fits your vehicles, site, supply and budget. You can ask for options from up to three brands, compared on features, software, warranty and service.' },
  { q: 'Do you install the charger as well?', a: 'Yes. Every charger we supply can come with installation and commissioning by our technicians, including cabling, the DB box, earthing and any civil work. We also install chargers you buy elsewhere.' },
  { q: 'AC or DC: which charger do I need?', a: 'AC chargers (3.3–22 kW) suit homes, offices and places where vehicles park for hours. DC fast chargers (30–240 kW) suit highways, public stations and fleets that need a quick top-up. The questions under Help me choose, at the top of this page, suggest a type and power in a minute.' },
  { q: 'Can I sell chargers under my own brand?', a: 'Yes. We arrange [white-label chargers](/chargers/white-label-chargers/) with your name and colours from makers we work with, and install them for your customers.' },
];
---
<HubPage
  title="Choose a Home EV Charger | Proline"
  description="Tell us your vehicle, city and parking arrangement. Get help choosing a charger from the brands we work with, and planning its installation."
  h1="Choose the right EV charger for your vehicle"
  eyebrow="Choose a charger"
  intro="Tell us your vehicle, where it parks and your electricity connection. We compare suitable chargers across the brands we work with on power, build, local service support and warranty, give you our tie-up quote, and install it."
  crumb="Chargers" items={items} itemsTitle="Charger categories" image="job-wallbox-stand" faqs={faqs} need="Help choosing a charger (any brand)">
  <section class="section" slot="before-list" id="help-me-choose" aria-labelledby="choose-title">
    <div class="wrap">
      <SectionHead eyebrow="Help me choose" title="Your vehicle, your parking, your supply" lead="Answer a few questions and see the charger type and power that fit, the features worth paying for and what the installation needs. Then ask us for options and our tie-up quote." id="choose-title" />
      <ChargerFinder />
    </div>
  </section>
  <section class="section section-soft" slot="before-list" aria-labelledby="car-title">
    <div class="wrap">
      <SectionHead eyebrow="Charger for your car" title="Your car may already come with a charger" lead="Check what your carmaker supplies and its own charging times before you buy anything extra." id="car-title" />
      <ul class="car-links" role="list">
        {cars.map((c) => <li><a href={c.href}><Icon name="car" size={20} />{c.label.replace(/ charger$/, '')}</a></li>)}
        <li><a href="/chargers/for/">All cars<Icon name="arrowRight" size={16} /></a></li>
      </ul>
    </div>
  </section>
  <section class="section" slot="before-list" id="types" aria-labelledby="types-title">
    <div class="wrap">
      <SectionHead eyebrow="Charger types" title="What each charger looks like, and how big it is" lead="Eleven common types, from a home socket to a bus depot charger. Tap Get a quote and tell us your vehicle and site: we suggest the right brand and model, then install it." id="types-title" />
      <ChargerTypes />
    </div>
  </section>
  <section class="section section-soft" slot="before-list" aria-labelledby="sizes-title">
    <div class="wrap">
      <SectionHead eyebrow="Sizes" title="How big chargers are, next to a person" id="sizes-title" />
      <ChargerSizes />
    </div>
  </section>
  <section class="section section-soft" aria-labelledby="neutral-title">
    <div class="wrap split">
      <SectionHead eyebrow="Brand-neutral" title="Advice about your site, not a catalogue" lead="Most charger sellers sell one brand. We work with many, so we can say which charger fits, which one doesn’t, and why. Tell us your vehicles, where they park, your supply and how fast they need to charge." id="neutral-title" />
      <ul class="ticks">
        <li><strong>Right power for your supply.</strong> A 7.4 kW charger on single phase, 11 or 22 kW on three phase, DC when the load allows.</li>
        <li><strong>Right connectors.</strong> Type 2 and CCS2 for cars, the right sockets and Type 6/7 chargers for 2W and 3W.</li>
        <li><strong>Right software.</strong> An app for home use, or OCPP to run public chargers on a CMS such as Proline CMS.</li>
        <li><strong>Service you can reach.</strong> Warranty terms and who fixes it, before you buy.</li>
      </ul>
    </div>
  </section>
</HubPage>

<style>
  .car-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .car-links a { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 16px; border: 1px solid var(--line-strong); border-radius: 6px; background: var(--white); color: var(--ink); font-weight: 600; text-decoration: none; }
  .car-links a:hover { border-color: var(--green-text); color: var(--green-text); }
  .car-links :global(svg) { color: var(--green-text); }
</style>
