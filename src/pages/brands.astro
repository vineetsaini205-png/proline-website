---
import SimplePage from '../layouts/SimplePage.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
---
<SimplePage
  title="Compare EV Charger Brands for Your Site | Proline"
  description="Compare suitability, service support, warranty and complete installation scope before choosing a charger brand."
  h1="Compare charger brands for your site"
  eyebrow="Charger brands"
  crumb="Charger brands"
  lead="We work with several charger makers, so we compare options for your vehicle and site on suitability, build quality, local service support, warranty and the complete installed scope, then give you our tie-up quote for the one that fits."
  cta={{ title: 'Ask for charger options', lead: 'Tell us your vehicles, site and supply, and we send options from up to three brands, compared on features, warranty and service.', need: 'Help choosing a charger (any brand)' }}>
  <section class="section" aria-labelledby="clients-title">
    <div class="wrap">
      <SectionHead eyebrow="Installed for" title="Clients we have done installation work for" id="clients-title" />
      <div class="grid grid-4">
        {site.clients.map((c) => <div class="card" style="align-items:center;justify-content:center;min-height:120px"><p style="font-family:var(--font-head);font-weight:700;font-size:24px;color:var(--ink)">{c}</p></div>)}
      </div>
      <p class="small muted" style="margin-top:14px">Brand names belong to their owners. Listing a client does not mean that company endorses Proline.</p>
    </div>
  </section>
  <section class="section section-soft" aria-labelledby="chargers-title">
    <div class="wrap">
      <SectionHead eyebrow="How we compare" title="How we choose between charger brands" lead="We start from your vehicle, site and supply, not from a catalogue. Then we compare the chargers that fit on the same points." id="chargers-title" />
      <div class="grid grid-2" style="gap:28px;margin-top:8px">
        <div>
          <h3>What we compare</h3>
          <ul class="ticks" style="margin-top:12px">
            <li><strong>Suitability.</strong> The power your vehicle accepts, the connector, single or three phase, indoor or outdoor.</li>
            <li><strong>Build quality.</strong> Enclosure rating, cable and connector quality, protection built into the charger.</li>
            <li><strong>Software.</strong> App control, OCPP for a CMS, load management and payments where you need them.</li>
            <li><strong>Local service support.</strong> Whether the maker has service people and spares where you are.</li>
            <li><strong>Warranty terms.</strong> What is covered, for how long, and who visits when something fails.</li>
            <li><strong>Complete installed cost.</strong> The charger together with cable, protection, earthing and any civil work.</li>
          </ul>
        </div>
        <div>
          <h3>What our tie-ups mean</h3>
          <p style="margin-top:12px">Proline has supply tie-ups with several charger makers. That is how we can quote for the charger and its installation together, in one tie-up quote. Our recommendation follows your requirements: if a charger from another brand suits your site better, we say so, and we also install chargers you buy elsewhere.</p>
          <h3 style="margin-top:22px">What you receive</h3>
          <p style="margin-top:12px">Up to three suitable options, each with its power, connector, software, warranty terms and local service support, and the full installation scope for your site, so you can compare like with like.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="partner-title">
    <div class="wrap split">
      <SectionHead eyebrow="For charger brands" title="Are you a charger brand?" lead="If you make or import chargers and need installation and commissioning for your customers, or want buyers in the states we cover, see how we work with charger brands." id="partner-title" />
      <p><a class="btn btn-primary btn-lg" href="/for/charger-brands/">Discuss an installation partnership<Icon name="arrowRight" size={18} /></a></p>
    </div>
  </section>
</SimplePage>
